# Vorlage: nach .env kopieren und alle Platzhalter ersetzen. Die .env wird nie committet.

# Datenbank-Passwort (wird von docker-compose.yml für die Datenbank verwendet)
POSTGRES_PASSWORD="bitte-ersetzen"

# Verbindung zur Datenbank für `npm run dev` (gleiches Passwort wie oben)
DATABASE_URL="postgresql://immo:bitte-ersetzen@localhost:5432/immo?schema=public"

# Geheimer Schlüssel für Sitzungen. Erzeugen mit: openssl rand -base64 32
AUTH_SECRET="bitte-ersetzen"
AUTH_TRUST_HOST=true

# Passwort, das `npm run db:seed` allen Demo-Benutzern gibt (nur lokal)
SEED_PASSWORT="bitte-ersetzen"

# Ablage für hochgeladene Fotos und Dokumente
UPLOAD_DIR="./uploads"

# KI-Analyse und KI-Vorschläge (optional). Schlüssel von https://console.anthropic.com (beginnt mit sk-ant-).
# Wird von docker-compose.yml an den App-Container weitergegeben; nach Änderung: docker compose up -d
# Ohne Schlüssel läuft die App normal, die KI-Seiten zeigen nur einen Hinweis (im Docker-Container);
# mit npm run dev entsteht eine Beispielantwort ohne KI. Vor echten Daten Datenschutz (AVV) prüfen.
ANTHROPIC_API_KEY=""
# Modell für die Analyse (Standard: claude-opus-5-5)
KI_MODELL=""

# Öffentliche Adresse der App (für Upload-Links), z. B. https://app.example.de. Leer lassen = Adresse aus der Anfrage.
APP_URL=""

# E-Mail-Eingang: Domain der Import-Adressen (lokal leer = eingang.localhost)
EINGANG_MAIL_DOMAIN=""
# Schlüssel für den Webhook /api/eingang/mail (nur für einen echten Mail-Dienst; leer = Webhook aus)
EINGANG_MAIL_SCHLUESSEL=""
