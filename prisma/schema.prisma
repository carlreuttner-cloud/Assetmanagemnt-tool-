// Datenmodell der Immobilien-App.
//
// Konventionen:
// - Jede fachliche Tabelle hat eine `mandantId`. Der Mandantenfilter wird zentral
//   in `src/lib/db/mandant.ts` gesetzt, nie von Hand in einzelnen Abfragen.
// - Geldbeträge: Decimal(14, 2). Zinssätze und Prozentanteile: Decimal(9, 6)
//   (z. B. 3.125000 = 3,125 %). Niemals Float.
// - Reine Datumsangaben (Stichtage, Vertragsbeginn) als @db.Date, Zeitpunkte als DateTime.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Mandanten, Benutzer, Rollen
// ---------------------------------------------------------------------------

enum Rolle {
  ADMIN
  MITARBEITER
  HAUSVERWALTUNG // darf nur Mieterlisten für zugewiesene Häuser hochladen
  INVESTOR // nur Lesezugriff auf zugewiesene Gesellschaften
}

model Mandant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  /// ISO-4217-Code. Vorerst immer EUR, für spätere Mehrwährungsfähigkeit vorbereitet.
  waehrung    String   @default("EUR")
  /// BCP-47-Sprachcode für Oberfläche und Formatierung, vorerst "de-DE".
  sprache     String   @default("de-DE")
  erstelltAm  DateTime @default(now())
  geaendertAm DateTime @updatedAt

  mitgliedschaften        Mitgliedschaft[]
  hausZuweisungen         HausZuweisung[]
  gesellschaftZuweisungen GesellschaftZuweisung[]
  gesellschaften          Gesellschaft[]
  haeuser                 Haus[]
  verkehrswerte           Verkehrswert[]
  gutachten               Gutachten[]
  fotos                   Foto[]
  einheiten               Einheit[]
  mieter                  Mieter[]
  mietverhaeltnisse       Mietverhaeltnis[]
  kredite                 Kredit[]
  covenants               Covenant[]
  kreditHaeuser           KreditHaus[]
  kreditbuchungen         Kreditbuchung[]
  kreditsalden            Kreditsaldo[]
  tilgungsplaene          Tilgungsplan[]
  tilgungsplanZeilen      TilgungsplanZeile[]
  referenzzinssaetze      Referenzzinssatz[]
  investitionen           Investition[]
  massnahmen              Massnahme[]
  bankkontostaende        Bankkontostand[]
  zinssicherungen         Zinssicherung[]
  exitrechnungen          Exitrechnung[]
  planpositionen          Planposition[]
  dokumente               Dokument[]
  aenderungsprotokoll     Aenderungsprotokoll[]
  importvorgaenge         Importvorgang[]
  szenarien               Szenario[]
  geschaeftsjahre         Geschaeftsjahr[]
  dokumentvorgaben        Dokumentvorgabe[]
  gesellschafter          Gesellschafter[]
  kapitalbewegungen       Kapitalbewegung[]
  waterfallvertraege      Waterfallvertrag[]
  dokumentnachweise       Dokumentnachweis[]
  kiAnalysen              KiAnalyse[]
  kiFragen                KiFrage[]
  kiVorschlaege           KiVorschlag[]
  portfolios              Portfolio[]
  lesezeichen             Lesezeichen[]
  dokumentSeiten          DokumentSeite[]
}

/// Ein Benutzer kann über Mitgliedschaften zu mehreren Mandanten gehören.
model Benutzer {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwortHash String
  aktiv        Boolean  @default(true)
  /// Optionale persönliche Sprache; sonst gilt die des Mandanten.
  sprache      String?
  erstelltAm   DateTime @default(now())
  geaendertAm  DateTime @updatedAt

  mitgliedschaften    Mitgliedschaft[]
  aenderungsprotokoll Aenderungsprotokoll[]
  importvorgaenge     Importvorgang[]
  szenarien           Szenario[]
  kiAnalysen          KiAnalyse[]
  kiFragen            KiFrage[]
  kiVorschlaege       KiVorschlag[]
  lesezeichen         Lesezeichen[]
  dokumente           Dokument[]
}

model Mitgliedschaft {
  id         String   @id @default(cuid())
  mandantId  String
  benutzerId String
  rolle      Rolle
  erstelltAm DateTime @default(now())

  mandant                 Mandant                 @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  benutzer                Benutzer                @relation(fields: [benutzerId], references: [id], onDelete: Cascade)
  hausZuweisungen         HausZuweisung[]
  gesellschaftZuweisungen GesellschaftZuweisung[]

  @@unique([mandantId, benutzerId])
  @@index([benutzerId])
}

/// Welche Häuser eine Hausverwaltung sehen und bearbeiten darf.
model HausZuweisung {
  id               String @id @default(cuid())
  mandantId        String
  mitgliedschaftId String
  hausId           String

  mandant        Mandant        @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  mitgliedschaft Mitgliedschaft @relation(fields: [mitgliedschaftId], references: [id], onDelete: Cascade)
  haus           Haus           @relation(fields: [hausId], references: [id], onDelete: Cascade)

  @@unique([mitgliedschaftId, hausId])
  @@index([mandantId])
}

/// Welche Gesellschaften ein Investor sehen darf.
model GesellschaftZuweisung {
  id               String @id @default(cuid())
  mandantId        String
  mitgliedschaftId String
  gesellschaftId   String

  mandant        Mandant        @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  mitgliedschaft Mitgliedschaft @relation(fields: [mitgliedschaftId], references: [id], onDelete: Cascade)
  gesellschaft   Gesellschaft   @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)

  @@unique([mitgliedschaftId, gesellschaftId])
  @@index([mandantId])
}

// ---------------------------------------------------------------------------
// Gesellschaften, Häuser, Einheiten
// ---------------------------------------------------------------------------

/// Gruppe von Gesellschaften, z. B. je Investorenkreis oder Region. Eine Gesellschaft gehört
/// zu höchstens einem Portfolio.
model Portfolio {
  id           String   @id @default(cuid())
  mandantId    String
  name         String
  beschreibung String?
  erstelltAm   DateTime @default(now())
  geaendertAm  DateTime @updatedAt

  mandant        Mandant        @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaften Gesellschaft[]

  @@unique([mandantId, name])
  @@index([mandantId])
}

model Gesellschaft {
  id                 String   @id @default(cuid())
  mandantId          String
  name               String
  rechtsform         String?
  registernummer     String?
  steuernummer       String?
  notiz              String?
  /// Portfolio, zu dem die Gesellschaft gehört; leer = "Ohne Portfolio"
  portfolioId        String?
  /// Mindestbestand an liquiden Mitteln für die Liquiditätsplanung; null = nicht festgelegt
  mindestliquiditaet Decimal? @db.Decimal(14, 2)
  erstelltAm         DateTime @default(now())
  geaendertAm        DateTime @updatedAt

  mandant           Mandant                 @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  portfolio         Portfolio?              @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  haeuser           Haus[]
  kredite           Kredit[]
  dokumente         Dokument[]
  zuweisungen       GesellschaftZuweisung[]
  szenarien         Szenario[]
  abschluesse       Geschaeftsjahr[]
  dokumentnachweise Dokumentnachweis[]
  gesellschafter    Gesellschafter[]
  waterfallvertrag  Waterfallvertrag?
  kiAnalysen        KiAnalyse[]
  kontostaende      Bankkontostand[]
  planpositionen    Planposition[]

  @@index([mandantId])
  @@index([portfolioId])
}

model Haus {
  id             String    @id @default(cuid())
  mandantId      String
  gesellschaftId String
  bezeichnung    String
  strasse        String?
  plz            String?
  ort            String?
  land           String    @default("DE")
  kaufpreis      Decimal?  @db.Decimal(14, 2)
  kaufdatum      DateTime? @db.Date
  notiz          String?
  erstelltAm     DateTime  @default(now())
  geaendertAm    DateTime  @updatedAt

  mandant           Mandant            @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft      Gesellschaft       @relation(fields: [gesellschaftId], references: [id], onDelete: Restrict)
  verkehrswerte     Verkehrswert[]
  gutachten         Gutachten[]
  fotos             Foto[]
  einheiten         Einheit[]
  kredite           KreditHaus[]
  investitionen     Investition[]
  massnahmen        Massnahme[]
  exitrechnungen    Exitrechnung[]
  kiVorschlaege     KiVorschlag[]
  dokumente         Dokument[]
  zuweisungen       HausZuweisung[]
  importe           Importvorgang[]
  dokumentnachweise Dokumentnachweis[]

  @@index([mandantId])
  @@index([gesellschaftId])
}

/// Verkehrswert mit Stichtag. Mehrere Einträge je Haus ergeben die Wertentwicklung.
model Verkehrswert {
  id         String   @id @default(cuid())
  mandantId  String
  hausId     String
  wert       Decimal  @db.Decimal(14, 2)
  stichtag   DateTime @db.Date
  /// z. B. "Gutachten", "Bankbewertung", "eigene Schätzung"
  quelle     String?
  notiz      String?
  erstelltAm DateTime @default(now())

  mandant   Mandant    @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus      Haus       @relation(fields: [hausId], references: [id], onDelete: Cascade)
  gutachten Gutachten?

  @@index([mandantId])
  @@index([hausId, stichtag])
}

enum Bewertungsverfahren {
  ERTRAGSWERT
  SACHWERT
  VERGLEICHSWERT
  SONSTIGES
}

/// Verkehrswertgutachten eines Hauses mit Bewertungsfaktoren, Objektdetails und SWOT des
/// Gutachters. Alle Faktoren sind optional: fehlt eine Angabe im Gutachten, bleibt sie leer
/// (wird nie geschätzt). Jedes Gutachten legt einen verknüpften Verkehrswert an.
model Gutachten {
  id             String               @id @default(cuid())
  mandantId      String
  hausId         String
  /// Wertermittlungsstichtag
  stichtag       DateTime             @db.Date
  /// Datum des Gutachtens
  erstelltAm     DateTime?            @db.Date
  gutachter      String?
  /// z. B. "Finanzierung", "Kauf", "Jahresabschluss"
  anlass         String?
  verfahren      Bewertungsverfahren?
  verkehrswert   Decimal              @db.Decimal(14, 2)
  verkehrswertId String?              @unique

  // Bewertungsfaktoren
  rohertragJahr          Decimal? @db.Decimal(14, 2)
  bewirtschaftungskosten Decimal? @db.Decimal(14, 2)
  reinertragJahr         Decimal? @db.Decimal(14, 2)
  /// Prozent
  liegenschaftszins      Decimal? @db.Decimal(9, 6)
  restnutzungsdauer      Int?
  gesamtnutzungsdauer    Int?
  /// Barwertfaktor (Vervielfältiger) laut Gutachten
  barwertfaktor          Decimal? @db.Decimal(9, 6)
  bodenwert              Decimal? @db.Decimal(14, 2)
  /// Gebäudewert laut Gutachten (z. B. Gebäudeertragswert oder Sachwert der baulichen Anlagen); fehlt er, zeigt die Ansicht Verkehrswert − Bodenwert als abgeleiteten Wert
  gebaeudewert           Decimal? @db.Decimal(14, 2)
  ertragswert            Decimal? @db.Decimal(14, 2)
  sachwert               Decimal? @db.Decimal(14, 2)
  vergleichswert         Decimal? @db.Decimal(14, 2)
  /// Zu- und Abschläge (Marktanpassung, besondere objektspezifische Grundstücksmerkmale), negativ = Abschlag
  zuAbschlaege           Decimal? @db.Decimal(14, 2)

  // Objektdetails laut Gutachten
  baujahr             Int?
  wohnflaeche         Decimal? @db.Decimal(10, 2)
  gewerbeflaeche      Decimal? @db.Decimal(10, 2)
  grundstuecksflaeche Decimal? @db.Decimal(10, 2)
  einheiten           Int?
  zustand             String?
  energieklasse       String?
  lage                String?

  // SWOT des Gutachters, je Zeile ein Punkt
  staerken   String?
  schwaechen String?
  chancen    String?
  risiken    String?

  notiz       String?
  angelegtAm  DateTime @default(now())
  geaendertAm DateTime @updatedAt

  mandant             Mandant       @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus                Haus          @relation(fields: [hausId], references: [id], onDelete: Cascade)
  verkehrswertEintrag Verkehrswert? @relation(fields: [verkehrswertId], references: [id], onDelete: SetNull)

  @@index([mandantId])
  @@index([hausId, stichtag])
}

model Foto {
  id           String   @id @default(cuid())
  mandantId    String
  hausId       String
  /// Pfad relativ zum Dateispeicher (siehe UPLOAD_DIR).
  speicherPfad String
  dateiname    String
  mimeType     String
  groesseBytes Int
  beschreibung String?
  reihenfolge  Int      @default(0)
  erstelltAm   DateTime @default(now())

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus    Haus    @relation(fields: [hausId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([hausId])
}

/// Nutzungsart einer Einheit. Farben und Texte zentral in src/lib/nutzungsart.ts bzw. src/i18n.
enum EinheitArt {
  WOHNUNG
  GEWERBE
  /// Stellplatz, Garage oder Tiefgaragenplatz; wird in Stück gezählt, nicht in der Wohn-/Gewerbefläche
  STELLPLATZ
}

model Einheit {
  id             String     @id @default(cuid())
  mandantId      String
  hausId         String
  bezeichnung    String
  art            EinheitArt
  /// Fläche in m²
  flaeche        Decimal    @db.Decimal(10, 2)
  lage           String? // z. B. "2. OG links"
  /// Erwartete Nettokaltmiete pro Monat bei Neuvermietung (Soll-Miete für Leerstand).
  /// Wird bei leeren Einheiten angezeigt; die Jahresmiete (× 12) wird berechnet, nie gespeichert.
  erwarteteMiete Decimal?   @db.Decimal(14, 2)
  notiz          String?
  erstelltAm     DateTime   @default(now())
  geaendertAm    DateTime   @updatedAt

  mandant           Mandant           @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus              Haus              @relation(fields: [hausId], references: [id], onDelete: Cascade)
  mietverhaeltnisse Mietverhaeltnis[]
  investitionen     Investition[]
  massnahmen        Massnahme[]
  dokumente         Dokument[]

  @@index([mandantId])
  @@index([hausId])
}

// ---------------------------------------------------------------------------
// Mieter und Mietverhältnisse
// ---------------------------------------------------------------------------

model Mieter {
  id          String   @id @default(cuid())
  mandantId   String
  /// Name der Person oder Firma
  name        String
  istFirma    Boolean  @default(false)
  email       String?
  telefon     String?
  notiz       String?
  erstelltAm  DateTime @default(now())
  geaendertAm DateTime @updatedAt

  mandant           Mandant           @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  mietverhaeltnisse Mietverhaeltnis[]

  @@index([mandantId])
}

model Mietverhaeltnis {
  id                  String    @id @default(cuid())
  mandantId           String
  einheitId           String
  mieterId            String
  beginn              DateTime  @db.Date
  ende                DateTime? @db.Date
  /// Tatsächlich gezahlte Nettokaltmiete pro Monat.
  /// Die Jahresnettokaltmiete (× 12) wird mit `jahresNettokaltmiete()` aus src/lib/miete.ts berechnet, nie gespeichert.
  istMiete            Decimal   @db.Decimal(14, 2)
  /// Vertraglich geschuldete Nettokaltmiete pro Monat
  sollMiete           Decimal   @db.Decimal(14, 2)
  letzteMieterhoehung DateTime? @db.Date
  /// Offener Mietrückstand zum Stichtag
  rueckstand          Decimal   @default(0) @db.Decimal(14, 2)
  rueckstandStichtag  DateTime? @db.Date
  notiz               String?
  erstelltAm          DateTime  @default(now())
  geaendertAm         DateTime  @updatedAt

  mandant   Mandant    @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  einheit   Einheit    @relation(fields: [einheitId], references: [id], onDelete: Cascade)
  mieter    Mieter     @relation(fields: [mieterId], references: [id], onDelete: Restrict)
  dokumente Dokument[]

  @@index([mandantId])
  @@index([einheitId])
  @@index([mieterId])
}

// ---------------------------------------------------------------------------
// Kredite
// ---------------------------------------------------------------------------

enum ZinsArt {
  FEST
  VARIABEL
}

enum Zahlweise {
  MONATLICH
  QUARTALSWEISE
  HALBJAEHRLICH
  JAEHRLICH
}

enum Tilgungsart {
  /// Gleichbleibende Rate (Zins + Tilgung); der Tilgungsanteil wächst.
  ANNUITAET
  /// Gleichbleibender Tilgungsbetrag; der Zins sinkt mit der Restschuld.
  RATENTILGUNG
  /// Nur Zinsen, Tilgung am Laufzeitende.
  ENDFAELLIG
}

model Kredit {
  id                  String      @id @default(cuid())
  mandantId           String
  gesellschaftId      String
  bezeichnung         String
  bank                String?
  kreditnummer        String?
  iban                String?
  ursprungsbetrag     Decimal     @db.Decimal(14, 2)
  auszahlungsdatum    DateTime?   @db.Date
  zinsArt             ZinsArt
  /// Fester Sollzins in Prozent p. a. (bei FEST)
  sollzins            Decimal?    @db.Decimal(9, 6)
  /// Referenzzins bei VARIABEL, z. B. "3M-EURIBOR"
  referenzzins        String?
  /// Aufschlag auf den Referenzzins in Prozentpunkten
  marge               Decimal?    @db.Decimal(9, 6)
  zinsbindungBis      DateTime?   @db.Date
  laufzeitBis         DateTime?   @db.Date
  zahlweise           Zahlweise   @default(MONATLICH)
  tilgungsart         Tilgungsart @default(ANNUITAET)
  /// Anfängliche Tilgung in Prozent p. a. des Ursprungsbetrags
  anfaenglicheTilgung Decimal?    @db.Decimal(9, 6)
  /// Annuität: aktuelle Rate (Zins + Tilgung) je Zahlung.
  /// Ratentilgung: Tilgungsbetrag je Zahlung. Endfällig: leer.
  ratenbetrag         Decimal?    @db.Decimal(14, 2)
  notiz               String?
  erstelltAm          DateTime    @default(now())
  geaendertAm         DateTime    @updatedAt

  mandant           Mandant            @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft      Gesellschaft       @relation(fields: [gesellschaftId], references: [id], onDelete: Restrict)
  haeuser           KreditHaus[]
  covenants         Covenant[]
  buchungen         Kreditbuchung[]
  salden            Kreditsaldo[]
  tilgungsplaene    Tilgungsplan[]
  dokumente         Dokument[]
  importe           Importvorgang[]
  dokumentnachweise Dokumentnachweis[]
  zinssicherungen   Zinssicherung[]

  @@index([mandantId])
  @@index([gesellschaftId])
}

enum ZinssicherungArt {
  /// Zinsobergrenze: der Referenzzins zählt höchstens bis zum Cap-Satz
  CAP
  /// Payer-Swap: statt des Referenzzinses wird der feste Swap-Satz gezahlt
  SWAP
}

/// Zinssicherung (Cap oder Swap) zu einem variablen Kredit.
model Zinssicherung {
  id          String           @id @default(cuid())
  mandantId   String
  kreditId    String
  art         ZinssicherungArt
  /// Cap: Obergrenze des Referenzzinses; Swap: fester Satz statt des Referenzzinses (Prozent p. a.)
  satz        Decimal          @db.Decimal(9, 6)
  /// Gesicherter Betrag; null = die gesamte Restschuld
  nominal     Decimal?         @db.Decimal(14, 2)
  beginn      DateTime         @db.Date
  ende        DateTime         @db.Date
  bank        String?
  /// Einmalige Prämie (Cap), nur zur Information
  praemie     Decimal?         @db.Decimal(14, 2)
  quelle      String?
  notiz       String?
  erstelltAm  DateTime         @default(now())
  geaendertAm DateTime         @updatedAt

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  kredit  Kredit  @relation(fields: [kreditId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([kreditId])
}

/// Stand eines Referenzzinses (z. B. 3M-EURIBOR) zu einem Stichtag. Daraus wird der
/// aktuelle Zinssatz variabler Kredite berechnet (Referenzzins, mindestens 0 %, plus Marge).
model Referenzzinssatz {
  id         String   @id @default(cuid())
  mandantId  String
  /// gleiche Schreibweise wie Kredit.referenzzins, z. B. "3M-EURIBOR"
  referenz   String
  stichtag   DateTime @db.Date
  /// in Prozentpunkten (2.13 = 2,13 %)
  satz       Decimal  @db.Decimal(9, 6)
  quelle     String?
  erstelltAm DateTime @default(now())

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  @@unique([mandantId, referenz, stichtag])
  @@index([mandantId])
}

enum CovenantVergleich {
  HOECHSTENS // Kennzahl darf den Schwellenwert nicht überschreiten (z. B. LTV)
  MINDESTENS // Kennzahl darf den Schwellenwert nicht unterschreiten (z. B. DSCR)
}

enum CovenantFolge {
  COVENANT // Vertragsauflage; Verletzung kann zur Kündigung oder Nachbesicherung führen
  AUSSCHUETTUNGSSPERRE // bei Unterschreiten der Bedingung dürfen keine Ausschüttungen erfolgen (Lock-up)
}

model Covenant {
  id            String             @id @default(cuid())
  mandantId     String
  kreditId      String
  folge         CovenantFolge      @default(COVENANT)
  /// Kennzahl, z. B. "LTV", "DSCR", "ICR"
  kennzahl      String
  vergleich     CovenantVergleich?
  schwellenwert Decimal?           @db.Decimal(14, 6)
  pruefrhythmus String? // z. B. "jährlich zum 31.12."
  beschreibung  String?
  erstelltAm    DateTime           @default(now())
  geaendertAm   DateTime           @updatedAt

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  kredit  Kredit  @relation(fields: [kreditId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([kreditId])
}

/// Zuordnung eines Kredits zu Häusern mit Anteil in Prozent (z. B. 60.000000 = 60 %).
model KreditHaus {
  id            String  @id @default(cuid())
  mandantId     String
  kreditId      String
  hausId        String
  anteilProzent Decimal @db.Decimal(9, 6)

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  kredit  Kredit  @relation(fields: [kreditId], references: [id], onDelete: Cascade)
  haus    Haus    @relation(fields: [hausId], references: [id], onDelete: Cascade)

  @@unique([kreditId, hausId])
  @@index([mandantId])
  @@index([hausId])
}

enum BuchungsArt {
  ZINS
  TILGUNG
  SONDERTILGUNG
  GEBUEHR
  AUSZAHLUNG
  SONSTIGES
}

model Kreditbuchung {
  id         String      @id @default(cuid())
  mandantId  String
  kreditId   String
  datum      DateTime    @db.Date
  art        BuchungsArt
  /// Betrag immer positiv; die Richtung ergibt sich aus der Art.
  betrag     Decimal     @db.Decimal(14, 2)
  /// Kontostand (Restschuld) nach der Buchung
  saldoNach  Decimal?    @db.Decimal(14, 2)
  notiz      String?
  erstelltAm DateTime    @default(now())

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  kredit  Kredit  @relation(fields: [kreditId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([kreditId, datum])
}

enum SaldoArt {
  DARLEHEN // Restschuld des Darlehens
  GUTHABEN // Guthaben, z. B. Tilgungsersatz- oder Zinsreservekonto; nie mit der Restschuld verrechnet
}

enum SaldoQuelle {
  KONTOAUSZUG
  BANKBESTAETIGUNG
  JAHRESABSCHLUSS
  SONSTIGE
}

enum SaldoStatus {
  BELEGT
  ENTWURF
}

/// Belegter Saldo eines Kredits zu einem Stichtag (z. B. Saldenbestätigung zum 31.12.).
/// Grundlage der Restschuld; Buchungssummen werden nie als Restschuld verwendet.
model Kreditsaldo {
  id              String      @id @default(cuid())
  mandantId       String
  kreditId        String
  /// leer, wenn der Stichtag aus dem Beleg nicht eindeutig hervorgeht
  stichtag        DateTime?   @db.Date
  /// Angabe aus dem Beleg bei unklarem Stichtag, z. B. "Ende 2023 (laut Notiz)"
  stichtagHinweis String?
  art             SaldoArt    @default(DARLEHEN)
  /// Betrag immer positiv
  betrag          Decimal     @db.Decimal(14, 2)
  quelle          SaldoQuelle
  /// z. B. "Saldenbestätigung Sparkasse vom 08.01.2026"
  quelleText      String?
  status          SaldoStatus @default(BELEGT)
  notiz           String?
  erstelltAm      DateTime    @default(now())
  geaendertAm     DateTime    @updatedAt

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  kredit  Kredit  @relation(fields: [kreditId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([kreditId, stichtag])
}

/// Tilgungsplan eines Kredits. Jede Änderung (z. B. nach Zinsanpassung) wird als
/// neue Version gespeichert; alte Versionen bleiben erhalten.
model Tilgungsplan {
  id          String   @id @default(cuid())
  mandantId   String
  kreditId    String
  version     Int
  gueltigAb   DateTime @db.Date
  bezeichnung String?
  erstelltAm  DateTime @default(now())

  mandant Mandant             @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  kredit  Kredit              @relation(fields: [kreditId], references: [id], onDelete: Cascade)
  zeilen  TilgungsplanZeile[]

  @@unique([kreditId, version])
  @@index([mandantId])
}

model TilgungsplanZeile {
  id             String   @id @default(cuid())
  mandantId      String
  tilgungsplanId String
  faelligAm      DateTime @db.Date
  zins           Decimal  @db.Decimal(14, 2)
  tilgung        Decimal  @db.Decimal(14, 2)
  rate           Decimal  @db.Decimal(14, 2)
  restschuld     Decimal  @db.Decimal(14, 2)

  mandant      Mandant      @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  tilgungsplan Tilgungsplan @relation(fields: [tilgungsplanId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([tilgungsplanId, faelligAm])
}

// ---------------------------------------------------------------------------
// Investitionen, Dokumente, Änderungsprotokoll
// ---------------------------------------------------------------------------

model Investition {
  id           String   @id @default(cuid())
  mandantId    String
  hausId       String
  einheitId    String?
  datum        DateTime @db.Date
  betrag       Decimal  @db.Decimal(14, 2)
  /// z. B. "Dach", "Heizung", "Modernisierung Wohnung"
  kategorie    String?
  beschreibung String
  /// Maßnahme, zu der diese Kostenposition gehört (Ist-Kosten); null = keiner Maßnahme zugeordnet
  massnahmeId  String?
  erstelltAm   DateTime @default(now())
  geaendertAm  DateTime @updatedAt

  mandant   Mandant    @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus      Haus       @relation(fields: [hausId], references: [id], onDelete: Cascade)
  einheit   Einheit?   @relation(fields: [einheitId], references: [id], onDelete: SetNull)
  massnahme Massnahme? @relation(fields: [massnahmeId], references: [id], onDelete: SetNull)

  @@index([mandantId])
  @@index([hausId])
  @@index([massnahmeId])
}

enum MassnahmeStatus {
  GEPLANT
  LAUFEND
  ABGESCHLOSSEN
}

/// Investitionsmaßnahme mit Budget; die Ist-Kosten sind die zugeordneten Investitionen (Kostenpositionen).
model Massnahme {
  id              String          @id @default(cuid())
  mandantId       String
  hausId          String
  einheitId       String?
  bezeichnung     String
  kategorie       String?
  status          MassnahmeStatus @default(GEPLANT)
  /// Budget; null = kein Budget festgelegt (Abweichung unbekannt)
  budget          Decimal?        @db.Decimal(14, 2)
  budgetQuelle    String?
  beginn          DateTime?       @db.Date
  ende            DateTime?       @db.Date
  /// Mehrmiete netto kalt je Monat durch die Maßnahme (nur der Monatswert wird gespeichert); null = unbekannt, 0 = keine Mehrmiete
  mehrmieteMonat  Decimal?        @db.Decimal(12, 2)
  /// true = durch Mietverträge/Mieterhöhungen belegt, false = erwartet
  mehrmieteBelegt Boolean         @default(false)
  mehrmieteQuelle String?
  notiz           String?
  erstelltAm      DateTime        @default(now())
  geaendertAm     DateTime        @updatedAt

  mandant Mandant       @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus    Haus          @relation(fields: [hausId], references: [id], onDelete: Cascade)
  einheit Einheit?      @relation(fields: [einheitId], references: [id], onDelete: SetNull)
  kosten  Investition[]

  @@index([mandantId])
  @@index([hausId])
}

/// Dokument mit optionalem Bezug zu genau einem Objekt (Gesellschaft, Haus, ...).
model Dokument {
  id                String              @id @default(cuid())
  mandantId         String
  /// Einheitlicher Name, z. B. "Jahresabschluss 2025 – Lindenhof Wohnen GmbH & Co. KG"
  titel             String
  /// z. B. "Kaufvertrag", "Mietvertrag", "Kreditvertrag", "Gutachten"
  kategorie         String?
  /// Geschäftsjahr bzw. Jahr, auf das sich das Dokument bezieht
  jahr              Int?
  /// Datum bzw. Stand des Dokuments
  dokumentDatum     DateTime?           @db.Date
  speicherPfad      String
  /// Originaler Dateiname beim Hochladen (bleibt unverändert gespeichert)
  dateiname         String
  mimeType          String
  groesseBytes      Int
  /// SHA-256 des Inhalts, um doppelte Uploads zu erkennen
  pruefsumme        String?
  /// Wer das Dokument ausgestellt bzw. geschickt hat (Art); null = unbekannt
  absenderArt       AbsenderArt?
  /// Name des Absenders, z. B. "Sparkasse Hamburg"
  absenderName      String?
  /// Name und Zuordnung vom Benutzer bestätigt; vorher nur Vorschlag
  bestaetigt        Boolean             @default(false)
  /// Woher der durchsuchbare Text stammt
  textQuelle        DokumentTextQuelle?
  /// z. B. "Texterkennung nicht installiert" oder "nur die ersten 40 Seiten erkannt"
  textHinweis       String?
  seitenAnzahl      Int?
  hochgeladenVonId  String?
  gesellschaftId    String?
  hausId            String?
  einheitId         String?
  mietverhaeltnisId String?
  kreditId          String?
  erstelltAm        DateTime            @default(now())
  geaendertAm       DateTime            @default(now()) @updatedAt

  mandant         Mandant          @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  hochgeladenVon  Benutzer?        @relation(fields: [hochgeladenVonId], references: [id], onDelete: SetNull)
  gesellschaft    Gesellschaft?    @relation(fields: [gesellschaftId], references: [id], onDelete: SetNull)
  haus            Haus?            @relation(fields: [hausId], references: [id], onDelete: SetNull)
  einheit         Einheit?         @relation(fields: [einheitId], references: [id], onDelete: SetNull)
  mietverhaeltnis Mietverhaeltnis? @relation(fields: [mietverhaeltnisId], references: [id], onDelete: SetNull)
  kredit          Kredit?          @relation(fields: [kreditId], references: [id], onDelete: SetNull)
  seiten          DokumentSeite[]

  @@index([mandantId])
  @@index([mandantId, bestaetigt])
}

enum DokumentTextQuelle {
  /// Textebene des PDFs
  PDF_TEXT
  /// Texterkennung (OCR) eines Scans oder Bildes
  OCR
  /// Kein Text gefunden bzw. nicht erkennbar
  KEINE
}

/// Durchsuchbarer Text je Seite (aus der Textebene oder per OCR), für die Volltextsuche mit Seitenangabe.
/// Absender eines Dokuments (wer es ausgestellt oder geschickt hat).
enum AbsenderArt {
  BANK
  HAUSVERWALTUNG
  GUTACHTER
  STEUERBERATER
  NOTAR
  BEHOERDE
  VERSICHERUNG
  MIETER
  GESELLSCHAFTER
  SONSTIGE
}

model DokumentSeite {
  id         String @id @default(cuid())
  mandantId  String
  dokumentId String
  /// Seitennummer ab 1
  nummer     Int
  text       String

  mandant  Mandant  @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  dokument Dokument @relation(fields: [dokumentId], references: [id], onDelete: Cascade)

  @@unique([dokumentId, nummer])
  @@index([mandantId])
}

enum AenderungsAktion {
  ERSTELLT
  GEAENDERT
  GELOESCHT
}

/// Wird automatisch von `src/lib/db/mandant.ts` geschrieben, nie von Hand.
model Aenderungsprotokoll {
  id          String           @id @default(cuid())
  mandantId   String
  benutzerId  String?
  zeitpunkt   DateTime         @default(now())
  tabelle     String
  datensatzId String
  aktion      AenderungsAktion
  alteWerte   Json?
  neueWerte   Json?

  mandant  Mandant   @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  benutzer Benutzer? @relation(fields: [benutzerId], references: [id], onDelete: SetNull)

  @@index([mandantId, zeitpunkt])
  @@index([tabelle, datensatzId])
}

enum ImportArt {
  KREDITBUCHUNGEN
  MIETERLISTE
}

/// Protokoll jedes übernommenen Imports: wer, wann, welche Datei und was sich geändert hat.
/// Die einzelnen Änderungen stehen zusätzlich im Änderungsprotokoll.
model Importvorgang {
  id         String    @id @default(cuid())
  mandantId  String
  art        ImportArt
  dateiname  String
  benutzerId String?
  hausId     String?
  kreditId   String?
  /// Stand der Mieterliste
  stand      DateTime? @db.Date
  /// Anzahl je Ergebnis, z. B. {"neu": 3, "unveraendert": 40}
  ergebnis   Json
  erstelltAm DateTime  @default(now())

  mandant  Mandant   @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  benutzer Benutzer? @relation(fields: [benutzerId], references: [id], onDelete: SetNull)
  haus     Haus?     @relation(fields: [hausId], references: [id], onDelete: SetNull)
  kredit   Kredit?   @relation(fields: [kreditId], references: [id], onDelete: SetNull)

  @@index([mandantId, erstelltAm])
}

/// Gespeichertes Was-wäre-wenn-Szenario. Die Parameter stehen als JSON (Beträge als Text,
/// Aufbau siehe `ParameterJson` in src/lib/szenario.ts); gerechnet wird immer neu mit den
/// aktuellen Daten.
model Szenario {
  id             String   @id @default(cuid())
  mandantId      String
  name           String
  beschreibung   String?
  /// Nur diese Gesellschaft; leer = gesamtes Portfolio
  gesellschaftId String?
  parameter      Json
  benutzerId     String?
  erstelltAm     DateTime @default(now())
  geaendertAm    DateTime @updatedAt

  mandant      Mandant       @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft? @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)
  benutzer     Benutzer?     @relation(fields: [benutzerId], references: [id], onDelete: SetNull)

  @@index([mandantId])
}

enum AbschlussQuelle {
  JAHRESABSCHLUSS
  BWA
  SONSTIGE
}

enum AbschlussStatus {
  ENDGUELTIG
  ENTWURF
}

/// Finanzzahlen einer Gesellschaft für ein Geschäftsjahr (GuV, Bilanz, Cashflow). Fehlende Posten bleiben null.
model Geschaeftsjahr {
  id             String          @id @default(cuid())
  mandantId      String
  gesellschaftId String
  /// Bezeichnung des Geschäftsjahrs, z. B. 2024
  jahr           Int
  beginn         DateTime        @db.Date
  /// Bilanzstichtag
  ende           DateTime        @db.Date
  quelle         AbschlussQuelle
  quelleText     String?
  status         AbschlussStatus

  // GuV
  umsatzerloese        Decimal? @db.Decimal(14, 2)
  sonstigeErtraege     Decimal? @db.Decimal(14, 2)
  /// Aufwand für bezogene Leistungen (Bewirtschaftung, Instandhaltung, nicht umgelegte Betriebskosten)
  materialaufwand      Decimal? @db.Decimal(14, 2)
  personalaufwand      Decimal? @db.Decimal(14, 2)
  sonstigeAufwendungen Decimal? @db.Decimal(14, 2)
  abschreibungen       Decimal? @db.Decimal(14, 2)
  zinsertraege         Decimal? @db.Decimal(14, 2)
  zinsaufwendungen     Decimal? @db.Decimal(14, 2)
  steuern              Decimal? @db.Decimal(14, 2)
  jahresergebnis       Decimal? @db.Decimal(14, 2)

  // Bilanz
  anlagevermoegen           Decimal? @db.Decimal(14, 2)
  /// Umlaufvermögen ohne liquide Mittel
  umlaufvermoegen           Decimal? @db.Decimal(14, 2)
  liquideMittel             Decimal? @db.Decimal(14, 2)
  eigenkapital              Decimal? @db.Decimal(14, 2)
  rueckstellungen           Decimal? @db.Decimal(14, 2)
  verbindlichkeitenBanken   Decimal? @db.Decimal(14, 2)
  sonstigeVerbindlichkeiten Decimal? @db.Decimal(14, 2)

  // Kapitalflussrechnung
  cashflowLaufend      Decimal? @db.Decimal(14, 2)
  cashflowInvestition  Decimal? @db.Decimal(14, 2)
  cashflowFinanzierung Decimal? @db.Decimal(14, 2)

  notiz       String?
  angelegtAm  DateTime @default(now())
  geaendertAm DateTime @updatedAt

  mandant      Mandant      @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)

  @@unique([gesellschaftId, jahr])
  @@index([mandantId])
}

enum DokumentBezug {
  GESELLSCHAFT
  HAUS
  KREDIT
}

/// Status, der sich aus vorhandenen Daten ableiten lässt, wenn kein eigener Nachweis erfasst ist.
enum DokumentAutomatik {
  GUTACHTEN
  JAHRESABSCHLUSS
  SALDENBESTAETIGUNG
}

/// Pflichtdokument (Art), das je Gesellschaft, Haus oder Kredit vorliegen soll.
model Dokumentvorgabe {
  id            String             @id @default(cuid())
  mandantId     String
  name          String
  bezug         DokumentBezug
  /// Wie lange ein Dokument als aktuell gilt (in Monaten ab Dokumentdatum); null = unbegrenzt
  gueltigMonate Int?
  automatik     DokumentAutomatik?
  beschreibung  String?
  reihenfolge   Int                @default(0)
  aktiv         Boolean            @default(true)
  angelegtAm    DateTime           @default(now())

  mandant   Mandant            @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  nachweise Dokumentnachweis[]

  @@unique([mandantId, bezug, name])
  @@index([mandantId])
}

/// Stand eines Pflichtdokuments für ein Objekt. Die Datei selbst folgt mit dem Dateispeicher (Produktionsreife).
model Dokumentnachweis {
  id                String    @id @default(cuid())
  mandantId         String
  vorgabeId         String
  gesellschaftId    String?
  hausId            String?
  kreditId          String?
  /// true = liegt vor, false = fehlt (bewusst so erfasst)
  vorhanden         Boolean
  /// Dokument wird für dieses Objekt nicht benötigt
  nichtErforderlich Boolean   @default(false)
  /// Datum bzw. Stand des Dokuments (z. B. Datum des Grundbuchauszugs)
  dokumentDatum     DateTime? @db.Date
  /// Wo das Dokument liegt (Ordner, Datenraum, Bank …)
  ablageort         String?
  notiz             String?
  geaendertAm       DateTime  @updatedAt

  mandant      Mandant         @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  vorgabe      Dokumentvorgabe @relation(fields: [vorgabeId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft?   @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)
  haus         Haus?           @relation(fields: [hausId], references: [id], onDelete: Cascade)
  kredit       Kredit?         @relation(fields: [kreditId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([vorgabeId])
}

enum KapitalbewegungArt {
  EINLAGE
  RUECKZAHLUNG
  AUSSCHUETTUNG
}

enum Verzinsung {
  EINFACH
  ZINSESZINS
}

/// Gesellschafter einer Gesellschaft (für die Verteilung eines Verkaufserlöses).
model Gesellschafter {
  id                  String   @id @default(cuid())
  mandantId           String
  gesellschaftId      String
  name                String
  /// Beteiligung am Kapital in Prozent (nur Anzeige)
  beteiligungProzent  Decimal? @db.Decimal(9, 6)
  /// Anteil an der Gewinnverteilung nach Vorzugsrendite in Prozent; null = laut Vertrag unbekannt
  gewinnanteilProzent Decimal? @db.Decimal(9, 6)
  notiz               String?
  angelegtAm          DateTime @default(now())

  mandant      Mandant           @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft      @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)
  bewegungen   Kapitalbewegung[]

  @@index([mandantId])
  @@index([gesellschaftId])
}

/// Einlage, Rückzahlung oder Ausschüttung eines Gesellschafters.
model Kapitalbewegung {
  id               String             @id @default(cuid())
  mandantId        String
  gesellschafterId String
  art              KapitalbewegungArt
  /// null = Datum unbekannt (dann keine Vorzugsrendite berechenbar)
  datum            DateTime?          @db.Date
  betrag           Decimal            @db.Decimal(14, 2)
  quelle           String?
  notiz            String?

  mandant        Mandant        @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschafter Gesellschafter @relation(fields: [gesellschafterId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([gesellschafterId])
}

/// Verteilungsregeln eines Verkaufserlöses laut Gesellschaftsvertrag. Fehlt der Eintrag, sind die Regeln unbekannt.
model Waterfallvertrag {
  id                       String     @id @default(cuid())
  mandantId                String
  gesellschaftId           String     @unique
  /// Vorzugsrendite auf das eingezahlte Kapital in Prozent p. a. (0 = keine)
  vorzugsrenditeProzent    Decimal    @db.Decimal(9, 6)
  verzinsung               Verzinsung
  /// Bereits erhaltene Ausschüttungen auf die Vorzugsrendite anrechnen
  ausschuettungenAnrechnen Boolean    @default(true)
  /// Beleg, z. B. "Gesellschaftsvertrag § 14"
  quelle                   String
  notiz                    String?
  geaendertAm              DateTime   @updatedAt

  mandant      Mandant      @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)

  @@index([mandantId])
}

enum KiAnalyseStatus {
  ERFOLGREICH
  FEHLER
}

/// Manuell gestartete KI-Analyse einer Gesellschaft. Gespeichert werden das gesendete
/// Datenpaket (nur gespeicherte Daten, ohne Personendaten) und das geprüfte Ergebnis.
model KiAnalyse {
  id             String          @id @default(cuid())
  mandantId      String
  gesellschaftId String
  benutzerId     String?
  stichtag       DateTime        @db.Date
  /// Optionaler Schwerpunkt, den der Benutzer vorgibt
  schwerpunkt    String?
  modell         String
  status         KiAnalyseStatus
  datenpaket     Json
  ergebnis       Json?
  fehler         String?
  tokensEingabe  Int?
  tokensAusgabe  Int?
  erstelltAm     DateTime        @default(now())

  mandant      Mandant      @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)
  benutzer     Benutzer?    @relation(fields: [benutzerId], references: [id], onDelete: SetNull)

  @@index([mandantId])
  @@index([gesellschaftId])
}

/// KI-Vorschlag für Szenario- und Exit-Annahmen eines Hauses (nur auf Knopfdruck). Gespeichert werden
/// das gesendete Datenpaket und die geprüfte Antwort; gerechnet wird nie durch die KI, sondern in
/// der Exit-Kalkulation und im Szenario.
model KiVorschlag {
  id            String          @id @default(cuid())
  mandantId     String
  hausId        String
  benutzerId    String?
  stichtag      DateTime        @db.Date
  modell        String
  status        KiAnalyseStatus
  datenpaket    Json
  ergebnis      Json?
  fehler        String?
  tokensEingabe Int?
  tokensAusgabe Int?
  erstelltAm    DateTime        @default(now())

  mandant  Mandant   @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus     Haus      @relation(fields: [hausId], references: [id], onDelete: Cascade)
  benutzer Benutzer? @relation(fields: [benutzerId], references: [id], onDelete: SetNull)

  @@index([mandantId])
  @@index([hausId])
}

/// Favoriten und „zuletzt angesehen“ je Benutzer und Mandant: ein Eintrag je aufgerufener Detailseite.
/// Titel ist der Name beim letzten Aufruf (zur Anzeige); geöffnet wird immer der Pfad mit Rechteprüfung.
model Lesezeichen {
  id          String    @id @default(cuid())
  mandantId   String
  benutzerId  String
  /// z. B. "/haeuser/<id>"
  pfad        String
  titel       String
  /// gesellschaft, haus, kredit, mieter, portfolio
  objektArt   String
  favorit     Boolean   @default(false)
  favoritSeit DateTime?
  angesehenAm DateTime?

  mandant  Mandant  @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  benutzer Benutzer @relation(fields: [benutzerId], references: [id], onDelete: Cascade)

  @@unique([mandantId, benutzerId, pfad])
  @@index([mandantId, benutzerId, angesehenAm])
}

// ---------------------------------------------------------------------------
// Liquiditätsplanung
// ---------------------------------------------------------------------------

/// Belegter Stand eines Bankkontos der Gesellschaft (Anfangsbestand der Liquiditätsplanung).
model Bankkontostand {
  id             String   @id @default(cuid())
  mandantId      String
  gesellschaftId String
  /// Bezeichnung des Kontos, z. B. "Geschäftskonto Sparkasse"
  konto          String
  stichtag       DateTime @db.Date
  /// Kontostand; negativ = Überziehung
  betrag         Decimal  @db.Decimal(14, 2)
  quelle         String?
  erstelltAm     DateTime @default(now())

  mandant      Mandant      @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([gesellschaftId])
}

enum PlanpositionArt {
  AUSSCHUETTUNG
  EINNAHME
  AUSGABE
}

/// Geplante Zahlung einer Gesellschaft in einem Monat (Ausschüttung, sonstige Einnahme oder Ausgabe).
model Planposition {
  id             String          @id @default(cuid())
  mandantId      String
  gesellschaftId String
  art            PlanpositionArt
  /// Erster Tag des Monats, in dem die Zahlung geplant ist
  monat          DateTime        @db.Date
  /// Betrag immer positiv; die Richtung ergibt sich aus der Art
  betrag         Decimal         @db.Decimal(14, 2)
  bezeichnung    String
  quelle         String?
  erstelltAm     DateTime        @default(now())
  geaendertAm    DateTime        @updatedAt

  mandant      Mandant      @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([gesellschaftId])
}

/// Gespeicherte Exit-Kalkulation eines Hauses (Annahmen; gerechnet wird immer neu im Code).
model Exitrechnung {
  id              String   @id @default(cuid())
  mandantId       String
  hausId          String
  name            String
  verkaufsdatum   DateTime @db.Date
  /// "miete", "marktwert", "gutachten" oder "frei"
  preisBasis      String
  /// nur bei Basis "frei"
  preis           Decimal? @db.Decimal(14, 2)
  /// Kaufpreisfaktor für die Basis "miete"; null = aus dem Gutachten
  faktor          Decimal? @db.Decimal(9, 4)
  maklerProzent   Decimal  @db.Decimal(9, 4)
  sonstigeProzent Decimal  @db.Decimal(9, 4)
  /// Vorfälligkeitsentschädigung in Prozent der Ablöse; null = unbekannt
  vfeProzent      Decimal? @db.Decimal(9, 4)
  /// Begründung bzw. Quellen der Annahmen
  notiz           String?
  erstelltAm      DateTime @default(now())
  geaendertAm     DateTime @updatedAt

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus    Haus    @relation(fields: [hausId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([hausId])
}

/// Frage an den KI-Assistenten mit generativer Antwort (Text und Bausteine wie Diagramme,
/// Tabellen, Kacheln). Die KI wählt nur Datenabfragen und Bausteine; alle Zahlen stehen in
/// `daten` (vom Code berechnet, mit Quelle und Stichtag) und werden so angezeigt, wie sie beim
/// Fragen galten. Nur für den fragenden Benutzer sichtbar, weil `daten` seiner Sichtbarkeit folgt.
model KiFrage {
  id            String          @id @default(cuid())
  mandantId     String
  benutzerId    String
  frage         String
  stichtag      DateTime        @db.Date
  modell        String
  status        KiAnalyseStatus
  /// Gewählte Datenabfragen und ihre Ergebnisse (Werte als Text)
  daten         Json?
  /// Bausteine der Antwort nach der Prüfung
  antwort       Json?
  fehler        String?
  tokensEingabe Int?
  tokensAusgabe Int?
  erstelltAm    DateTime        @default(now())

  mandant  Mandant  @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  benutzer Benutzer @relation(fields: [benutzerId], references: [id], onDelete: Cascade)

  @@index([mandantId, benutzerId])
}
