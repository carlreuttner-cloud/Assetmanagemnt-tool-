// Datenmodell der Immobilien-App.
//
// Konventionen:
// - Jede fachliche Tabelle hat eine `mandantId`. Der Mandantenfilter wird zentral
//   in `src/lib/db/mandant.ts` gesetzt, nie von Hand in einzelnen Abfragen.
// - Geldbeträge: Decimal(14, 2). Zinssätze und Prozentanteile: Decimal(9, 6)
//   (z. B. 3.125000 = 3,125 %). Niemals Float.
// - Reine Datumsangaben (Stichtage, Vertragsbeginn) als @db.Date, Zeitpunkte als DateTime.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Mandanten, Benutzer, Rollen
// ---------------------------------------------------------------------------

enum Rolle {
  ADMIN
  MITARBEITER
  HAUSVERWALTUNG // darf nur Mieterlisten für zugewiesene Häuser hochladen
  INVESTOR // nur Lesezugriff auf zugewiesene Gesellschaften
}

model Mandant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  /// ISO-4217-Code. Vorerst immer EUR, für spätere Mehrwährungsfähigkeit vorbereitet.
  waehrung    String   @default("EUR")
  /// BCP-47-Sprachcode für Oberfläche und Formatierung, vorerst "de-DE".
  sprache     String   @default("de-DE")
  erstelltAm  DateTime @default(now())
  geaendertAm DateTime @updatedAt

  mitgliedschaften        Mitgliedschaft[]
  hausZuweisungen         HausZuweisung[]
  gesellschaftZuweisungen GesellschaftZuweisung[]
  gesellschaften          Gesellschaft[]
  haeuser                 Haus[]
  verkehrswerte           Verkehrswert[]
  gutachten               Gutachten[]
  fotos                   Foto[]
  einheiten               Einheit[]
  mieter                  Mieter[]
  mietverhaeltnisse       Mietverhaeltnis[]
  kredite                 Kredit[]
  covenants               Covenant[]
  kreditHaeuser           KreditHaus[]
  kreditbuchungen         Kreditbuchung[]
  kreditsalden            Kreditsaldo[]
  tilgungsplaene          Tilgungsplan[]
  tilgungsplanZeilen      TilgungsplanZeile[]
  referenzzinssaetze      Referenzzinssatz[]
  investitionen           Investition[]
  massnahmen              Massnahme[]
  bankkontostaende        Bankkontostand[]
  zinssicherungen         Zinssicherung[]
  exitrechnungen          Exitrechnung[]
  planpositionen          Planposition[]
  dokumente               Dokument[]
  eingaenge               Eingang[]
  zuordnungsregeln        Zuordnungsregel[]
  uploadLinks             UploadLink[]
  mailPostfach            MailPostfach?
  mailAbsender            MailAbsender[]
  eingangMails            EingangMail[]
  bankangebote            Bankangebot[]
  sicherheiten            Sicherheit[]
  covenantNachweise       CovenantNachweis[]
  quartalsberichte        Quartalsbericht[]
  sicherheitHaeuser       SicherheitHaus[]
  sicherheitKredite       SicherheitKredit[]
  aenderungsprotokoll     Aenderungsprotokoll[]
  importvorgaenge         Importvorgang[]
  szenarien               Szenario[]
  geschaeftsjahre         Geschaeftsjahr[]
  dokumentvorgaben        Dokumentvorgabe[]
  gesellschafter          Gesellschafter[]
  kapitalbewegungen       Kapitalbewegung[]
  waterfallvertraege      Waterfallvertrag[]
  dokumentnachweise       Dokumentnachweis[]
  kiAnalysen              KiAnalyse[]
  kiFragen                KiFrage[]
  kiVorschlaege           KiVorschlag[]
  portfolios              Portfolio[]
  lesezeichen             Lesezeichen[]
  dokumentSeiten          DokumentSeite[]
  kapitalabrufe           Kapitalabruf[]
  kapitalabrufPositionen  KapitalabrufPosition[]
  planjahre               Planjahr[]
  planerklaerungen        Planerklaerung[]
  energieausweise         Energieausweis[]
  energieverbraeuche      Energieverbrauch[]
  bauteile                Bauteil[]
  mieterstaende           Mieterstand[]
  hausverwaltungen        Hausverwaltung[]
  hausverwaltungZuordnungen HausverwaltungZuordnung[]
  mieterstandZeilen       MieterstandZeile[]
  briefvorlagen           Briefvorlage[]
  briefserien             Briefserie[]
}

/// Ein Benutzer kann über Mitgliedschaften zu mehreren Mandanten gehören.
model Benutzer {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwortHash String
  aktiv        Boolean  @default(true)
  /// Optionale persönliche Sprache; sonst gilt die des Mandanten.
  sprache      String?
  erstelltAm   DateTime @default(now())
  geaendertAm  DateTime @updatedAt

  mitgliedschaften    Mitgliedschaft[]
  aenderungsprotokoll Aenderungsprotokoll[]
  importvorgaenge     Importvorgang[]
  szenarien           Szenario[]
  kiAnalysen          KiAnalyse[]
  kiFragen            KiFrage[]
  kiVorschlaege       KiVorschlag[]
  lesezeichen         Lesezeichen[]
  dokumente           Dokument[]
}

model Mitgliedschaft {
  id         String   @id @default(cuid())
  mandantId  String
  benutzerId String
  rolle      Rolle
  erstelltAm DateTime @default(now())

  mandant                 Mandant                 @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  benutzer                Benutzer                @relation(fields: [benutzerId], references: [id], onDelete: Cascade)
  hausZuweisungen         HausZuweisung[]
  gesellschaftZuweisungen GesellschaftZuweisung[]
  gesellschafter          Gesellschafter[]

  @@unique([mandantId, benutzerId])
  @@index([benutzerId])
}

/// Welche Häuser eine Hausverwaltung sehen und bearbeiten darf.
model HausZuweisung {
  id               String @id @default(cuid())
  mandantId        String
  mitgliedschaftId String
  hausId           String

  mandant        Mandant        @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  mitgliedschaft Mitgliedschaft @relation(fields: [mitgliedschaftId], references: [id], onDelete: Cascade)
  haus           Haus           @relation(fields: [hausId], references: [id], onDelete: Cascade)

  @@unique([mitgliedschaftId, hausId])
  @@index([mandantId])
}

/// Welche Gesellschaften ein Investor sehen darf.
model GesellschaftZuweisung {
  id               String @id @default(cuid())
  mandantId        String
  mitgliedschaftId String
  gesellschaftId   String

  mandant        Mandant        @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  mitgliedschaft Mitgliedschaft @relation(fields: [mitgliedschaftId], references: [id], onDelete: Cascade)
  gesellschaft   Gesellschaft   @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)

  @@unique([mitgliedschaftId, gesellschaftId])
  @@index([mandantId])
}

// ---------------------------------------------------------------------------
// Gesellschaften, Häuser, Einheiten
// ---------------------------------------------------------------------------

/// Gruppe von Gesellschaften, z. B. je Investorenkreis oder Region. Eine Gesellschaft gehört
/// zu höchstens einem Portfolio.
model Portfolio {
  id           String   @id @default(cuid())
  mandantId    String
  name         String
  beschreibung String?
  erstelltAm   DateTime @default(now())
  geaendertAm  DateTime @updatedAt

  mandant        Mandant        @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaften Gesellschaft[]

  @@unique([mandantId, name])
  @@index([mandantId])
}

model Gesellschaft {
  id                 String   @id @default(cuid())
  mandantId          String
  name               String
  rechtsform         String?
  registernummer     String?
  steuernummer       String?
  notiz              String?
  /// Portfolio, zu dem die Gesellschaft gehört; leer = "Ohne Portfolio"
  portfolioId        String?
  /// Mindestbestand an liquiden Mitteln für die Liquiditätsplanung; null = nicht festgelegt
  mindestliquiditaet Decimal? @db.Decimal(14, 2)
  erstelltAm         DateTime @default(now())
  geaendertAm        DateTime @updatedAt

  mandant           Mandant                 @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  portfolio         Portfolio?              @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  haeuser           Haus[]
  kredite           Kredit[]
  dokumente         Dokument[]
  zuordnungsregeln  Zuordnungsregel[]
  zuweisungen       GesellschaftZuweisung[]
  szenarien         Szenario[]
  abschluesse       Geschaeftsjahr[]
  dokumentnachweise Dokumentnachweis[]
  gesellschafter    Gesellschafter[]
  waterfallvertrag  Waterfallvertrag?
  kiAnalysen        KiAnalyse[]
  kontostaende      Bankkontostand[]
  planpositionen    Planposition[]
  bankangebote      Bankangebot[]
  sicherheiten      Sicherheit[]
  quartalsberichte  Quartalsbericht[]
  kapitalabrufe     Kapitalabruf[]
  planjahre         Planjahr[]

  @@index([mandantId])
  @@index([portfolioId])
}

model Haus {
  id             String    @id @default(cuid())
  mandantId      String
  gesellschaftId String
  bezeichnung    String
  strasse        String?
  plz            String?
  ort            String?
  land           String    @default("DE")
  kaufpreis      Decimal?  @db.Decimal(14, 2)
  kaufdatum      DateTime? @db.Date
  notiz          String?
  erstelltAm     DateTime  @default(now())
  geaendertAm    DateTime  @updatedAt

  mandant            Mandant            @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft       Gesellschaft       @relation(fields: [gesellschaftId], references: [id], onDelete: Restrict)
  verkehrswerte      Verkehrswert[]
  gutachten          Gutachten[]
  fotos              Foto[]
  einheiten          Einheit[]
  kredite            KreditHaus[]
  investitionen      Investition[]
  massnahmen         Massnahme[]
  exitrechnungen     Exitrechnung[]
  kiVorschlaege      KiVorschlag[]
  dokumente          Dokument[]
  zuordnungsregeln   Zuordnungsregel[]
  zuweisungen        HausZuweisung[]
  importe            Importvorgang[]
  dokumentnachweise  Dokumentnachweis[]
  sicherheiten       SicherheitHaus[]
  energieausweise    Energieausweis[]
  energieverbraeuche Energieverbrauch[]
  bauteile           Bauteil[]
  mieterstaende      Mieterstand[]
  verwaltungen       HausverwaltungZuordnung[]

  @@index([mandantId])
  @@index([gesellschaftId])
}

/// Verkehrswert mit Stichtag. Mehrere Einträge je Haus ergeben die Wertentwicklung.
model Verkehrswert {
  id         String   @id @default(cuid())
  mandantId  String
  hausId     String
  wert       Decimal  @db.Decimal(14, 2)
  stichtag   DateTime @db.Date
  /// z. B. "Gutachten", "Bankbewertung", "eigene Schätzung"
  quelle     String?
  notiz      String?
  erstelltAm DateTime @default(now())

  mandant   Mandant    @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus      Haus       @relation(fields: [hausId], references: [id], onDelete: Cascade)
  gutachten Gutachten?

  @@index([mandantId])
  @@index([hausId, stichtag])
}

enum Bewertungsverfahren {
  ERTRAGSWERT
  SACHWERT
  VERGLEICHSWERT
  SONSTIGES
}

/// Verkehrswertgutachten eines Hauses mit Bewertungsfaktoren, Objektdetails und SWOT des
/// Gutachters. Alle Faktoren sind optional: fehlt eine Angabe im Gutachten, bleibt sie leer
/// (wird nie geschätzt). Jedes Gutachten legt einen verknüpften Verkehrswert an.
model Gutachten {
  id             String               @id @default(cuid())
  mandantId      String
  hausId         String
  /// Wertermittlungsstichtag
  stichtag       DateTime             @db.Date
  /// Datum des Gutachtens
  erstelltAm     DateTime?            @db.Date
  gutachter      String?
  /// z. B. "Finanzierung", "Kauf", "Jahresabschluss"
  anlass         String?
  verfahren      Bewertungsverfahren?
  verkehrswert   Decimal              @db.Decimal(14, 2)
  verkehrswertId String?              @unique

  // Bewertungsfaktoren
  rohertragJahr          Decimal? @db.Decimal(14, 2)
  bewirtschaftungskosten Decimal? @db.Decimal(14, 2)
  reinertragJahr         Decimal? @db.Decimal(14, 2)
  /// Prozent
  liegenschaftszins      Decimal? @db.Decimal(9, 6)
  restnutzungsdauer      Int?
  gesamtnutzungsdauer    Int?
  /// Barwertfaktor (Vervielfältiger) laut Gutachten
  barwertfaktor          Decimal? @db.Decimal(9, 6)
  bodenwert              Decimal? @db.Decimal(14, 2)
  /// Gebäudewert laut Gutachten (z. B. Gebäudeertragswert oder Sachwert der baulichen Anlagen); fehlt er, zeigt die Ansicht Verkehrswert − Bodenwert als abgeleiteten Wert
  gebaeudewert           Decimal? @db.Decimal(14, 2)
  ertragswert            Decimal? @db.Decimal(14, 2)
  sachwert               Decimal? @db.Decimal(14, 2)
  vergleichswert         Decimal? @db.Decimal(14, 2)
  /// Zu- und Abschläge (Marktanpassung, besondere objektspezifische Grundstücksmerkmale), negativ = Abschlag
  zuAbschlaege           Decimal? @db.Decimal(14, 2)

  // Objektdetails laut Gutachten
  baujahr             Int?
  wohnflaeche         Decimal? @db.Decimal(10, 2)
  gewerbeflaeche      Decimal? @db.Decimal(10, 2)
  grundstuecksflaeche Decimal? @db.Decimal(10, 2)
  einheiten           Int?
  zustand             String?
  energieklasse       String?
  lage                String?

  // SWOT des Gutachters, je Zeile ein Punkt
  staerken   String?
  schwaechen String?
  chancen    String?
  risiken    String?

  notiz       String?
  angelegtAm  DateTime @default(now())
  geaendertAm DateTime @updatedAt

  mandant             Mandant       @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus                Haus          @relation(fields: [hausId], references: [id], onDelete: Cascade)
  verkehrswertEintrag Verkehrswert? @relation(fields: [verkehrswertId], references: [id], onDelete: SetNull)

  @@index([mandantId])
  @@index([hausId, stichtag])
}

model Foto {
  id           String   @id @default(cuid())
  mandantId    String
  hausId       String
  /// Pfad relativ zum Dateispeicher (siehe UPLOAD_DIR).
  speicherPfad String
  dateiname    String
  mimeType     String
  groesseBytes Int
  beschreibung String?
  reihenfolge  Int      @default(0)
  erstelltAm   DateTime @default(now())

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus    Haus    @relation(fields: [hausId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([hausId])
}

/// Nutzungsart einer Einheit. Farben und Texte zentral in src/lib/nutzungsart.ts bzw. src/i18n.
enum EinheitArt {
  WOHNUNG
  GEWERBE
  /// Stellplatz, Garage oder Tiefgaragenplatz; wird in Stück gezählt, nicht in der Wohn-/Gewerbefläche
  STELLPLATZ
}

model Einheit {
  id             String     @id @default(cuid())
  mandantId      String
  hausId         String
  bezeichnung    String
  art            EinheitArt
  /// Fläche in m²
  flaeche        Decimal    @db.Decimal(10, 2)
  lage           String? // z. B. "2. OG links"
  /// Erwartete Nettokaltmiete pro Monat bei Neuvermietung (Soll-Miete für Leerstand).
  /// Wird bei leeren Einheiten angezeigt; die Jahresmiete (× 12) wird berechnet, nie gespeichert.
  erwarteteMiete Decimal?   @db.Decimal(14, 2)
  notiz          String?
  erstelltAm     DateTime   @default(now())
  geaendertAm    DateTime   @updatedAt

  mandant           Mandant           @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus              Haus              @relation(fields: [hausId], references: [id], onDelete: Cascade)
  mietverhaeltnisse Mietverhaeltnis[]
  investitionen     Investition[]
  massnahmen        Massnahme[]
  dokumente         Dokument[]
  standZeilen       MieterstandZeile[]

  @@index([mandantId])
  @@index([hausId])
}

// ---------------------------------------------------------------------------
// Mieter und Mietverhältnisse
// ---------------------------------------------------------------------------

model Mieter {
  id          String   @id @default(cuid())
  mandantId   String
  /// Name der Person oder Firma
  name        String
  istFirma    Boolean  @default(false)
  email       String?
  telefon     String?
  notiz       String?
  erstelltAm  DateTime @default(now())
  geaendertAm DateTime @updatedAt

  mandant           Mandant           @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  mietverhaeltnisse Mietverhaeltnis[]

  @@index([mandantId])
}

model Mietverhaeltnis {
  id                  String    @id @default(cuid())
  mandantId           String
  einheitId           String
  mieterId            String
  beginn              DateTime  @db.Date
  ende                DateTime? @db.Date
  /// Tatsächlich gezahlte Nettokaltmiete pro Monat.
  /// Die Jahresnettokaltmiete (× 12) wird mit `jahresNettokaltmiete()` aus src/lib/miete.ts berechnet, nie gespeichert.
  istMiete            Decimal   @db.Decimal(14, 2)
  /// Vertraglich geschuldete Nettokaltmiete pro Monat
  sollMiete           Decimal   @db.Decimal(14, 2)
  letzteMieterhoehung DateTime? @db.Date
  /// Offener Mietrückstand zum Stichtag
  rueckstand          Decimal   @default(0) @db.Decimal(14, 2)
  rueckstandStichtag  DateTime? @db.Date
  notiz               String?
  erstelltAm          DateTime  @default(now())
  geaendertAm         DateTime  @updatedAt

  mandant   Mandant    @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  einheit   Einheit    @relation(fields: [einheitId], references: [id], onDelete: Cascade)
  mieter    Mieter     @relation(fields: [mieterId], references: [id], onDelete: Restrict)
  dokumente Dokument[]

  @@index([mandantId])
  @@index([einheitId])
  @@index([mieterId])
}

// ---------------------------------------------------------------------------
// Kredite
// ---------------------------------------------------------------------------

enum ZinsArt {
  FEST
  VARIABEL
}

enum Zahlweise {
  MONATLICH
  QUARTALSWEISE
  HALBJAEHRLICH
  JAEHRLICH
}

enum Tilgungsart {
  /// Gleichbleibende Rate (Zins + Tilgung); der Tilgungsanteil wächst.
  ANNUITAET
  /// Gleichbleibender Tilgungsbetrag; der Zins sinkt mit der Restschuld.
  RATENTILGUNG
  /// Nur Zinsen, Tilgung am Laufzeitende.
  ENDFAELLIG
}

enum KreditArt {
  /// Bankdarlehen (vorrangig, in der Regel grundpfandrechtlich gesichert)
  BANK
  /// Darlehen eines Gesellschafters an die Gesellschaft
  GESELLSCHAFTERDARLEHEN
  /// Nachrangdarlehen eines Dritten (z. B. Mezzanine)
  NACHRANGDARLEHEN
}

enum SondertilgungRecht {
  UNBEKANNT
  KEINES
  PROZENT
  BETRAG
}

enum SondertilgungJahr {
  KALENDERJAHR
  /// ab dem Auszahlungstag
  VERTRAGSJAHR
}

model Kredit {
  id                        String             @id @default(cuid())
  mandantId                 String
  gesellschaftId            String
  bezeichnung               String
  /// Bank bzw. Darlehensgeber
  bank                      String?
  kreditart                 KreditArt          @default(BANK)
  /// Rang der Rückzahlung bei Nachrang- und Gesellschafterdarlehen (1 = zuerst); Bankdarlehen gehen immer vor
  rang                      Int?
  /// Darlehensgeber bei Gesellschafterdarlehen
  gesellschafterId          String?
  kreditnummer              String?
  iban                      String?
  ursprungsbetrag           Decimal            @db.Decimal(14, 2)
  auszahlungsdatum          DateTime?          @db.Date
  zinsArt                   ZinsArt
  /// Fester Sollzins in Prozent p. a. (bei FEST)
  sollzins                  Decimal?           @db.Decimal(9, 6)
  /// Referenzzins bei VARIABEL, z. B. "3M-EURIBOR"
  referenzzins              String?
  /// Aufschlag auf den Referenzzins in Prozentpunkten
  marge                     Decimal?           @db.Decimal(9, 6)
  zinsbindungBis            DateTime?          @db.Date
  laufzeitBis               DateTime?          @db.Date
  zahlweise                 Zahlweise          @default(MONATLICH)
  tilgungsart               Tilgungsart        @default(ANNUITAET)
  /// Anfängliche Tilgung in Prozent p. a. des Ursprungsbetrags
  anfaenglicheTilgung       Decimal?           @db.Decimal(9, 6)
  /// Annuität: aktuelle Rate (Zins + Tilgung) je Zahlung.
  /// Ratentilgung: Tilgungsbetrag je Zahlung. Endfällig: leer.
  ratenbetrag               Decimal?           @db.Decimal(14, 2)
  /// Sondertilgungsrecht laut Vertrag; UNBEKANNT = nicht erfasst (Datenlücke)
  sondertilgungRecht        SondertilgungRecht @default(UNBEKANNT)
  /// Prozent des Ursprungsbetrags (PROZENT) oder Betrag in € (BETRAG) je Jahr
  sondertilgungWert         Decimal?           @db.Decimal(14, 6)
  sondertilgungJahr         SondertilgungJahr  @default(KALENDERJAHR)
  /// Nicht genutzte Beträge gehen ins nächste Jahr über
  sondertilgungUebertragbar Boolean            @default(false)
  /// Recht gilt bis (leer: bis Ende der Zinsbindung bzw. Laufzeit)
  sondertilgungBis          DateTime?          @db.Date
  notiz                     String?
  erstelltAm                DateTime           @default(now())
  geaendertAm               DateTime           @updatedAt

  mandant           Mandant            @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft      Gesellschaft       @relation(fields: [gesellschaftId], references: [id], onDelete: Restrict)
  gesellschafter    Gesellschafter?    @relation(fields: [gesellschafterId], references: [id], onDelete: SetNull)
  haeuser           KreditHaus[]
  covenants         Covenant[]
  buchungen         Kreditbuchung[]
  salden            Kreditsaldo[]
  tilgungsplaene    Tilgungsplan[]
  dokumente         Dokument[]
  zuordnungsregeln  Zuordnungsregel[]
  importe           Importvorgang[]
  dokumentnachweise Dokumentnachweis[]
  zinssicherungen   Zinssicherung[]
  bankangebote      Bankangebot[]
  sicherheiten      SicherheitKredit[]
  covenantNachweise CovenantNachweis[]

  @@index([mandantId])
  @@index([gesellschaftId])
}

enum ZinssicherungArt {
  /// Zinsobergrenze: der Referenzzins zählt höchstens bis zum Cap-Satz
  CAP
  /// Payer-Swap: statt des Referenzzinses wird der feste Swap-Satz gezahlt
  SWAP
}

/// Zinssicherung (Cap oder Swap) zu einem variablen Kredit.
model Zinssicherung {
  id          String           @id @default(cuid())
  mandantId   String
  kreditId    String
  art         ZinssicherungArt
  /// Cap: Obergrenze des Referenzzinses; Swap: fester Satz statt des Referenzzinses (Prozent p. a.)
  satz        Decimal          @db.Decimal(9, 6)
  /// Gesicherter Betrag; null = die gesamte Restschuld
  nominal     Decimal?         @db.Decimal(14, 2)
  beginn      DateTime         @db.Date
  ende        DateTime         @db.Date
  bank        String?
  /// Einmalige Prämie (Cap), nur zur Information
  praemie     Decimal?         @db.Decimal(14, 2)
  quelle      String?
  notiz       String?
  erstelltAm  DateTime         @default(now())
  geaendertAm DateTime         @updatedAt

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  kredit  Kredit  @relation(fields: [kreditId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([kreditId])
}

/// Stand eines Referenzzinses (z. B. 3M-EURIBOR) zu einem Stichtag. Daraus wird der
/// aktuelle Zinssatz variabler Kredite berechnet (Referenzzins, mindestens 0 %, plus Marge).
model Referenzzinssatz {
  id         String   @id @default(cuid())
  mandantId  String
  /// gleiche Schreibweise wie Kredit.referenzzins, z. B. "3M-EURIBOR"
  referenz   String
  stichtag   DateTime @db.Date
  /// in Prozentpunkten (2.13 = 2,13 %)
  satz       Decimal  @db.Decimal(9, 6)
  quelle     String?
  erstelltAm DateTime @default(now())

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  @@unique([mandantId, referenz, stichtag])
  @@index([mandantId])
}

enum CovenantVergleich {
  HOECHSTENS // Kennzahl darf den Schwellenwert nicht überschreiten (z. B. LTV)
  MINDESTENS // Kennzahl darf den Schwellenwert nicht unterschreiten (z. B. DSCR)
}

enum CovenantFolge {
  COVENANT // Vertragsauflage; Verletzung kann zur Kündigung oder Nachbesicherung führen
  AUSSCHUETTUNGSSPERRE // bei Unterschreiten der Bedingung dürfen keine Ausschüttungen erfolgen (Lock-up)
}

model Covenant {
  id                  String             @id @default(cuid())
  mandantId           String
  kreditId            String
  folge               CovenantFolge      @default(COVENANT)
  /// Kennzahl, z. B. "LTV", "DSCR", "ICR"
  kennzahl            String
  vergleich           CovenantVergleich?
  schwellenwert       Decimal?           @db.Decimal(14, 6)
  pruefrhythmus       String? // z. B. "jährlich zum 31.12."
  /// Testtermine: erster (oder ein bekannter) Termin und Abstand in Monaten; ohne beides keine Termine
  ersterTest          DateTime?          @db.Date
  testIntervallMonate Int?
  beschreibung        String?
  erstelltAm          DateTime           @default(now())
  geaendertAm         DateTime           @updatedAt

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  kredit  Kredit  @relation(fields: [kreditId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([kreditId])
}

/// Zuordnung eines Kredits zu Häusern mit Anteil in Prozent (z. B. 60.000000 = 60 %).
model KreditHaus {
  id            String  @id @default(cuid())
  mandantId     String
  kreditId      String
  hausId        String
  anteilProzent Decimal @db.Decimal(9, 6)

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  kredit  Kredit  @relation(fields: [kreditId], references: [id], onDelete: Cascade)
  haus    Haus    @relation(fields: [hausId], references: [id], onDelete: Cascade)

  @@unique([kreditId, hausId])
  @@index([mandantId])
  @@index([hausId])
}

enum BuchungsArt {
  ZINS
  TILGUNG
  SONDERTILGUNG
  GEBUEHR
  AUSZAHLUNG
  SONSTIGES
}

model Kreditbuchung {
  id         String      @id @default(cuid())
  mandantId  String
  kreditId   String
  datum      DateTime    @db.Date
  art        BuchungsArt
  /// Betrag immer positiv; die Richtung ergibt sich aus der Art.
  betrag     Decimal     @db.Decimal(14, 2)
  /// Kontostand (Restschuld) nach der Buchung
  saldoNach  Decimal?    @db.Decimal(14, 2)
  notiz      String?
  erstelltAm DateTime    @default(now())

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  kredit  Kredit  @relation(fields: [kreditId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([kreditId, datum])
}

enum SaldoArt {
  DARLEHEN // Restschuld des Darlehens
  GUTHABEN // Guthaben, z. B. Tilgungsersatz- oder Zinsreservekonto; nie mit der Restschuld verrechnet
}

enum SaldoQuelle {
  KONTOAUSZUG
  BANKBESTAETIGUNG
  JAHRESABSCHLUSS
  SONSTIGE
}

enum SaldoStatus {
  BELEGT
  ENTWURF
}

/// Belegter Saldo eines Kredits zu einem Stichtag (z. B. Saldenbestätigung zum 31.12.).
/// Grundlage der Restschuld; Buchungssummen werden nie als Restschuld verwendet.
model Kreditsaldo {
  id              String      @id @default(cuid())
  mandantId       String
  kreditId        String
  /// leer, wenn der Stichtag aus dem Beleg nicht eindeutig hervorgeht
  stichtag        DateTime?   @db.Date
  /// Angabe aus dem Beleg bei unklarem Stichtag, z. B. "Ende 2023 (laut Notiz)"
  stichtagHinweis String?
  art             SaldoArt    @default(DARLEHEN)
  /// Betrag immer positiv
  betrag          Decimal     @db.Decimal(14, 2)
  quelle          SaldoQuelle
  /// z. B. "Saldenbestätigung Sparkasse vom 08.01.2026"
  quelleText      String?
  status          SaldoStatus @default(BELEGT)
  notiz           String?
  erstelltAm      DateTime    @default(now())
  geaendertAm     DateTime    @updatedAt

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  kredit  Kredit  @relation(fields: [kreditId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([kreditId, stichtag])
}

/// Tilgungsplan eines Kredits. Jede Änderung (z. B. nach Zinsanpassung) wird als
/// neue Version gespeichert; alte Versionen bleiben erhalten.
model Tilgungsplan {
  id          String   @id @default(cuid())
  mandantId   String
  kreditId    String
  version     Int
  gueltigAb   DateTime @db.Date
  bezeichnung String?
  erstelltAm  DateTime @default(now())

  mandant Mandant             @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  kredit  Kredit              @relation(fields: [kreditId], references: [id], onDelete: Cascade)
  zeilen  TilgungsplanZeile[]

  @@unique([kreditId, version])
  @@index([mandantId])
}

model TilgungsplanZeile {
  id             String   @id @default(cuid())
  mandantId      String
  tilgungsplanId String
  faelligAm      DateTime @db.Date
  zins           Decimal  @db.Decimal(14, 2)
  tilgung        Decimal  @db.Decimal(14, 2)
  rate           Decimal  @db.Decimal(14, 2)
  restschuld     Decimal  @db.Decimal(14, 2)

  mandant      Mandant      @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  tilgungsplan Tilgungsplan @relation(fields: [tilgungsplanId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([tilgungsplanId, faelligAm])
}

// ---------------------------------------------------------------------------
// Investitionen, Dokumente, Änderungsprotokoll
// ---------------------------------------------------------------------------

model Investition {
  id           String   @id @default(cuid())
  mandantId    String
  hausId       String
  einheitId    String?
  datum        DateTime @db.Date
  betrag       Decimal  @db.Decimal(14, 2)
  /// z. B. "Dach", "Heizung", "Modernisierung Wohnung"
  kategorie    String?
  beschreibung String
  /// Maßnahme, zu der diese Kostenposition gehört (Ist-Kosten); null = keiner Maßnahme zugeordnet
  massnahmeId  String?
  erstelltAm   DateTime @default(now())
  geaendertAm  DateTime @updatedAt

  mandant   Mandant    @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus      Haus       @relation(fields: [hausId], references: [id], onDelete: Cascade)
  einheit   Einheit?   @relation(fields: [einheitId], references: [id], onDelete: SetNull)
  massnahme Massnahme? @relation(fields: [massnahmeId], references: [id], onDelete: SetNull)

  @@index([mandantId])
  @@index([hausId])
  @@index([massnahmeId])
}

enum MassnahmeStatus {
  GEPLANT
  LAUFEND
  ABGESCHLOSSEN
}

/// Investitionsmaßnahme mit Budget; die Ist-Kosten sind die zugeordneten Investitionen (Kostenpositionen).
model Massnahme {
  id              String          @id @default(cuid())
  mandantId       String
  hausId          String
  einheitId       String?
  bezeichnung     String
  kategorie       String?
  status          MassnahmeStatus @default(GEPLANT)
  /// Budget; null = kein Budget festgelegt (Abweichung unbekannt)
  budget          Decimal?        @db.Decimal(14, 2)
  budgetQuelle    String?
  beginn          DateTime?       @db.Date
  ende            DateTime?       @db.Date
  /// Mehrmiete netto kalt je Monat durch die Maßnahme (nur der Monatswert wird gespeichert); null = unbekannt, 0 = keine Mehrmiete
  mehrmieteMonat  Decimal?        @db.Decimal(12, 2)
  /// true = durch Mietverträge/Mieterhöhungen belegt, false = erwartet
  mehrmieteBelegt Boolean         @default(false)
  mehrmieteQuelle String?
  notiz           String?
  erstelltAm      DateTime        @default(now())
  geaendertAm     DateTime        @updatedAt

  mandant Mandant       @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus    Haus          @relation(fields: [hausId], references: [id], onDelete: Cascade)
  einheit Einheit?      @relation(fields: [einheitId], references: [id], onDelete: SetNull)
  kosten  Investition[]

  @@index([mandantId])
  @@index([hausId])
}

/// Dokument mit optionalem Bezug zu genau einem Objekt (Gesellschaft, Haus, ...).
model Dokument {
  id                  String              @id @default(cuid())
  mandantId           String
  /// Einheitlicher Name, z. B. "Jahresabschluss 2025 – Lindenhof Wohnen GmbH & Co. KG"
  titel               String
  /// z. B. "Kaufvertrag", "Mietvertrag", "Kreditvertrag", "Gutachten"
  kategorie           String?
  /// Geschäftsjahr bzw. Jahr, auf das sich das Dokument bezieht
  jahr                Int?
  /// Datum bzw. Stand des Dokuments
  dokumentDatum       DateTime?           @db.Date
  speicherPfad        String
  /// Originaler Dateiname beim Hochladen (bleibt unverändert gespeichert)
  dateiname           String
  mimeType            String
  groesseBytes        Int
  /// SHA-256 des Inhalts, um doppelte Uploads zu erkennen
  pruefsumme          String?
  /// Wer das Dokument ausgestellt bzw. geschickt hat (Art); null = unbekannt
  absenderArt         AbsenderArt?
  /// Name des Absenders, z. B. "Sparkasse Hamburg"
  absenderName        String?
  /// Name und Zuordnung vom Benutzer bestätigt; vorher nur Vorschlag
  bestaetigt          Boolean             @default(false)
  /// Woher der durchsuchbare Text stammt
  textQuelle          DokumentTextQuelle?
  /// z. B. "Texterkennung nicht installiert" oder "nur die ersten 40 Seiten erkannt"
  textHinweis         String?
  seitenAnzahl        Int?
  hochgeladenVonId    String?
  /// Für Investoren der zugeordneten Gesellschaft freigegeben (null = nicht freigegeben)
  investorFreigabeAm  DateTime?
  investorFreigabeVon String?
  /// Serienbrief, aus dem das Dokument erzeugt wurde
  briefserieId        String?
  gesellschaftId      String?
  hausId              String?
  einheitId           String?
  mietverhaeltnisId   String?
  kreditId            String?
  erstelltAm          DateTime            @default(now())
  geaendertAm         DateTime            @default(now()) @updatedAt

  mandant         Mandant          @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  hochgeladenVon  Benutzer?        @relation(fields: [hochgeladenVonId], references: [id], onDelete: SetNull)
  gesellschaft    Gesellschaft?    @relation(fields: [gesellschaftId], references: [id], onDelete: SetNull)
  haus            Haus?            @relation(fields: [hausId], references: [id], onDelete: SetNull)
  briefserie      Briefserie?      @relation(fields: [briefserieId], references: [id], onDelete: SetNull)
  einheit         Einheit?         @relation(fields: [einheitId], references: [id], onDelete: SetNull)
  mietverhaeltnis Mietverhaeltnis? @relation(fields: [mietverhaeltnisId], references: [id], onDelete: SetNull)
  kredit          Kredit?          @relation(fields: [kreditId], references: [id], onDelete: SetNull)
  seiten          DokumentSeite[]

  eingang      Eingang?
  bankangebote Bankangebot[]
  sicherheiten Sicherheit[]

  @@index([mandantId])
  @@index([mandantId, bestaetigt])
}

enum DokumentTextQuelle {
  /// Textebene des PDFs
  PDF_TEXT
  /// Texterkennung (OCR) eines Scans oder Bildes
  OCR
  /// Kein Text gefunden bzw. nicht erkennbar
  KEINE
}

/// Durchsuchbarer Text je Seite (aus der Textebene oder per OCR), für die Volltextsuche mit Seitenangabe.
/// Absender eines Dokuments (wer es ausgestellt oder geschickt hat).
enum AbsenderArt {
  BANK
  HAUSVERWALTUNG
  GUTACHTER
  STEUERBERATER
  NOTAR
  BEHOERDE
  VERSICHERUNG
  MIETER
  GESELLSCHAFTER
  SONSTIGE
}

model DokumentSeite {
  id         String @id @default(cuid())
  mandantId  String
  dokumentId String
  /// Seitennummer ab 1
  nummer     Int
  text       String

  mandant  Mandant  @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  dokument Dokument @relation(fields: [dokumentId], references: [id], onDelete: Cascade)

  @@unique([dokumentId, nummer])
  @@index([mandantId])
}

enum AenderungsAktion {
  ERSTELLT
  GEAENDERT
  GELOESCHT
}

/// Wird automatisch von `src/lib/db/mandant.ts` geschrieben, nie von Hand.
model Aenderungsprotokoll {
  id          String           @id @default(cuid())
  mandantId   String
  benutzerId  String?
  zeitpunkt   DateTime         @default(now())
  tabelle     String
  datensatzId String
  aktion      AenderungsAktion
  alteWerte   Json?
  neueWerte   Json?

  mandant  Mandant   @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  benutzer Benutzer? @relation(fields: [benutzerId], references: [id], onDelete: SetNull)

  @@index([mandantId, zeitpunkt])
  @@index([tabelle, datensatzId])
}

enum ImportArt {
  KREDITBUCHUNGEN
  MIETERLISTE
}

/// Protokoll jedes übernommenen Imports: wer, wann, welche Datei und was sich geändert hat.
/// Die einzelnen Änderungen stehen zusätzlich im Änderungsprotokoll.
model Importvorgang {
  id         String    @id @default(cuid())
  mandantId  String
  art        ImportArt
  dateiname  String
  benutzerId String?
  hausId     String?
  kreditId   String?
  /// Stand der Mieterliste
  stand      DateTime? @db.Date
  /// Anzahl je Ergebnis, z. B. {"neu": 3, "unveraendert": 40}
  ergebnis   Json
  erstelltAm DateTime  @default(now())

  mandant  Mandant   @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  benutzer Benutzer? @relation(fields: [benutzerId], references: [id], onDelete: SetNull)
  haus     Haus?     @relation(fields: [hausId], references: [id], onDelete: SetNull)
  kredit   Kredit?   @relation(fields: [kreditId], references: [id], onDelete: SetNull)
  staende  Mieterstand[]

  @@index([mandantId, erstelltAm])
}

/// Gespeichertes Was-wäre-wenn-Szenario. Die Parameter stehen als JSON (Beträge als Text,
/// Aufbau siehe `ParameterJson` in src/lib/szenario.ts); gerechnet wird immer neu mit den
/// aktuellen Daten.
model Szenario {
  id             String   @id @default(cuid())
  mandantId      String
  name           String
  beschreibung   String?
  /// Nur diese Gesellschaft; leer = gesamtes Portfolio
  gesellschaftId String?
  parameter      Json
  benutzerId     String?
  erstelltAm     DateTime @default(now())
  geaendertAm    DateTime @updatedAt

  mandant      Mandant       @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft? @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)
  benutzer     Benutzer?     @relation(fields: [benutzerId], references: [id], onDelete: SetNull)

  @@index([mandantId])
}

enum AbschlussQuelle {
  JAHRESABSCHLUSS
  BWA
  SONSTIGE
}

enum AbschlussStatus {
  ENDGUELTIG
  ENTWURF
}

/// Finanzzahlen einer Gesellschaft für ein Geschäftsjahr (GuV, Bilanz, Cashflow). Fehlende Posten bleiben null.
model Geschaeftsjahr {
  id             String          @id @default(cuid())
  mandantId      String
  gesellschaftId String
  /// Bezeichnung des Geschäftsjahrs, z. B. 2024
  jahr           Int
  beginn         DateTime        @db.Date
  /// Bilanzstichtag
  ende           DateTime        @db.Date
  quelle         AbschlussQuelle
  quelleText     String?
  status         AbschlussStatus

  // GuV
  umsatzerloese        Decimal? @db.Decimal(14, 2)
  sonstigeErtraege     Decimal? @db.Decimal(14, 2)
  /// Aufwand für bezogene Leistungen (Bewirtschaftung, Instandhaltung, nicht umgelegte Betriebskosten)
  materialaufwand      Decimal? @db.Decimal(14, 2)
  personalaufwand      Decimal? @db.Decimal(14, 2)
  sonstigeAufwendungen Decimal? @db.Decimal(14, 2)
  abschreibungen       Decimal? @db.Decimal(14, 2)
  zinsertraege         Decimal? @db.Decimal(14, 2)
  zinsaufwendungen     Decimal? @db.Decimal(14, 2)
  steuern              Decimal? @db.Decimal(14, 2)
  jahresergebnis       Decimal? @db.Decimal(14, 2)

  // Bilanz
  anlagevermoegen           Decimal? @db.Decimal(14, 2)
  /// Umlaufvermögen ohne liquide Mittel
  umlaufvermoegen           Decimal? @db.Decimal(14, 2)
  liquideMittel             Decimal? @db.Decimal(14, 2)
  eigenkapital              Decimal? @db.Decimal(14, 2)
  rueckstellungen           Decimal? @db.Decimal(14, 2)
  verbindlichkeitenBanken   Decimal? @db.Decimal(14, 2)
  sonstigeVerbindlichkeiten Decimal? @db.Decimal(14, 2)

  // Kapitalflussrechnung
  cashflowLaufend      Decimal? @db.Decimal(14, 2)
  cashflowInvestition  Decimal? @db.Decimal(14, 2)
  cashflowFinanzierung Decimal? @db.Decimal(14, 2)

  notiz       String?
  angelegtAm  DateTime @default(now())
  geaendertAm DateTime @updatedAt

  mandant      Mandant      @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)

  @@unique([gesellschaftId, jahr])
  @@index([mandantId])
}

enum DokumentBezug {
  GESELLSCHAFT
  HAUS
  KREDIT
}

/// Status, der sich aus vorhandenen Daten ableiten lässt, wenn kein eigener Nachweis erfasst ist.
enum DokumentAutomatik {
  GUTACHTEN
  JAHRESABSCHLUSS
  SALDENBESTAETIGUNG
}

/// Pflichtdokument (Art), das je Gesellschaft, Haus oder Kredit vorliegen soll.
model Dokumentvorgabe {
  id            String             @id @default(cuid())
  mandantId     String
  name          String
  bezug         DokumentBezug
  /// Wie lange ein Dokument als aktuell gilt (in Monaten ab Dokumentdatum); null = unbegrenzt
  gueltigMonate Int?
  automatik     DokumentAutomatik?
  beschreibung  String?
  reihenfolge   Int                @default(0)
  aktiv         Boolean            @default(true)
  angelegtAm    DateTime           @default(now())

  mandant   Mandant            @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  nachweise Dokumentnachweis[]

  @@unique([mandantId, bezug, name])
  @@index([mandantId])
}

/// Stand eines Pflichtdokuments für ein Objekt. Die Datei selbst folgt mit dem Dateispeicher (Produktionsreife).
model Dokumentnachweis {
  id                String    @id @default(cuid())
  mandantId         String
  vorgabeId         String
  gesellschaftId    String?
  hausId            String?
  kreditId          String?
  /// true = liegt vor, false = fehlt (bewusst so erfasst)
  vorhanden         Boolean
  /// Dokument wird für dieses Objekt nicht benötigt
  nichtErforderlich Boolean   @default(false)
  /// Datum bzw. Stand des Dokuments (z. B. Datum des Grundbuchauszugs)
  dokumentDatum     DateTime? @db.Date
  /// Wo das Dokument liegt (Ordner, Datenraum, Bank …)
  ablageort         String?
  notiz             String?
  geaendertAm       DateTime  @updatedAt

  mandant      Mandant         @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  vorgabe      Dokumentvorgabe @relation(fields: [vorgabeId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft?   @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)
  haus         Haus?           @relation(fields: [hausId], references: [id], onDelete: Cascade)
  kredit       Kredit?         @relation(fields: [kreditId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([vorgabeId])
}

enum KapitalbewegungArt {
  EINLAGE
  RUECKZAHLUNG
  AUSSCHUETTUNG
}

enum Verzinsung {
  EINFACH
  ZINSESZINS
}

/// Gesellschafter einer Gesellschaft (für die Verteilung eines Verkaufserlöses).
model Gesellschafter {
  id                  String   @id @default(cuid())
  mandantId           String
  gesellschaftId      String
  name                String
  /// Beteiligung am Kapital in Prozent (nur Anzeige)
  beteiligungProzent  Decimal? @db.Decimal(9, 6)
  /// Anteil an der Gewinnverteilung nach Vorzugsrendite in Prozent; null = laut Vertrag unbekannt
  gewinnanteilProzent Decimal? @db.Decimal(9, 6)
  notiz               String?
  /// Zugang zum Investorenportal: Mitgliedschaft (Rolle Investor), die dieses Kapitalkonto sieht
  mitgliedschaftId    String?
  angelegtAm          DateTime @default(now())

  mandant        Mandant                @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft   Gesellschaft           @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)
  mitgliedschaft Mitgliedschaft?        @relation(fields: [mitgliedschaftId], references: [id], onDelete: SetNull)
  bewegungen     Kapitalbewegung[]
  darlehen       Kredit[]
  abrufe         KapitalabrufPosition[]

  @@index([mandantId])
  @@index([gesellschaftId])
}

/// Einlage, Rückzahlung oder Ausschüttung eines Gesellschafters.
model Kapitalbewegung {
  id               String             @id @default(cuid())
  mandantId        String
  gesellschafterId String
  art              KapitalbewegungArt
  /// null = Datum unbekannt (dann keine Vorzugsrendite berechenbar)
  datum            DateTime?          @db.Date
  betrag           Decimal            @db.Decimal(14, 2)
  quelle           String?
  notiz            String?
  /// Zahlungseingang auf eine Position eines Kapitalabrufs
  abrufPositionId  String?

  mandant        Mandant               @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschafter Gesellschafter        @relation(fields: [gesellschafterId], references: [id], onDelete: Cascade)
  abrufPosition  KapitalabrufPosition? @relation(fields: [abrufPositionId], references: [id], onDelete: SetNull)

  @@index([mandantId])
  @@index([gesellschafterId])
}

/// Verteilungsregeln eines Verkaufserlöses laut Gesellschaftsvertrag. Fehlt der Eintrag, sind die Regeln unbekannt.
model Waterfallvertrag {
  id                       String     @id @default(cuid())
  mandantId                String
  gesellschaftId           String     @unique
  /// Vorzugsrendite auf das eingezahlte Kapital in Prozent p. a. (0 = keine)
  vorzugsrenditeProzent    Decimal    @db.Decimal(9, 6)
  verzinsung               Verzinsung
  /// Bereits erhaltene Ausschüttungen auf die Vorzugsrendite anrechnen
  ausschuettungenAnrechnen Boolean    @default(true)
  /// Beleg, z. B. "Gesellschaftsvertrag § 14"
  quelle                   String
  notiz                    String?
  geaendertAm              DateTime   @updatedAt

  mandant      Mandant      @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)

  @@index([mandantId])
}

enum KiAnalyseStatus {
  ERFOLGREICH
  FEHLER
}

/// Manuell gestartete KI-Analyse einer Gesellschaft. Gespeichert werden das gesendete
/// Datenpaket (nur gespeicherte Daten, ohne Personendaten) und das geprüfte Ergebnis.
model KiAnalyse {
  id             String          @id @default(cuid())
  mandantId      String
  gesellschaftId String
  benutzerId     String?
  stichtag       DateTime        @db.Date
  /// Optionaler Schwerpunkt, den der Benutzer vorgibt
  schwerpunkt    String?
  modell         String
  status         KiAnalyseStatus
  datenpaket     Json
  ergebnis       Json?
  fehler         String?
  tokensEingabe  Int?
  tokensAusgabe  Int?
  erstelltAm     DateTime        @default(now())

  mandant      Mandant      @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)
  benutzer     Benutzer?    @relation(fields: [benutzerId], references: [id], onDelete: SetNull)

  @@index([mandantId])
  @@index([gesellschaftId])
}

/// KI-Vorschlag für Szenario- und Exit-Annahmen eines Hauses (nur auf Knopfdruck). Gespeichert werden
/// das gesendete Datenpaket und die geprüfte Antwort; gerechnet wird nie durch die KI, sondern in
/// der Exit-Kalkulation und im Szenario.
model KiVorschlag {
  id            String          @id @default(cuid())
  mandantId     String
  hausId        String
  benutzerId    String?
  stichtag      DateTime        @db.Date
  modell        String
  status        KiAnalyseStatus
  datenpaket    Json
  ergebnis      Json?
  fehler        String?
  tokensEingabe Int?
  tokensAusgabe Int?
  erstelltAm    DateTime        @default(now())

  mandant  Mandant   @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus     Haus      @relation(fields: [hausId], references: [id], onDelete: Cascade)
  benutzer Benutzer? @relation(fields: [benutzerId], references: [id], onDelete: SetNull)

  @@index([mandantId])
  @@index([hausId])
}

/// Favoriten und „zuletzt angesehen“ je Benutzer und Mandant: ein Eintrag je aufgerufener Detailseite.
/// Titel ist der Name beim letzten Aufruf (zur Anzeige); geöffnet wird immer der Pfad mit Rechteprüfung.
model Lesezeichen {
  id          String    @id @default(cuid())
  mandantId   String
  benutzerId  String
  /// z. B. "/haeuser/<id>"
  pfad        String
  titel       String
  /// gesellschaft, haus, kredit, mieter, portfolio
  objektArt   String
  favorit     Boolean   @default(false)
  favoritSeit DateTime?
  angesehenAm DateTime?

  mandant  Mandant  @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  benutzer Benutzer @relation(fields: [benutzerId], references: [id], onDelete: Cascade)

  @@unique([mandantId, benutzerId, pfad])
  @@index([mandantId, benutzerId, angesehenAm])
}

// ---------------------------------------------------------------------------
// Liquiditätsplanung
// ---------------------------------------------------------------------------

/// Belegter Stand eines Bankkontos der Gesellschaft (Anfangsbestand der Liquiditätsplanung).
model Bankkontostand {
  id             String   @id @default(cuid())
  mandantId      String
  gesellschaftId String
  /// Bezeichnung des Kontos, z. B. "Geschäftskonto Sparkasse"
  konto          String
  stichtag       DateTime @db.Date
  /// Kontostand; negativ = Überziehung
  betrag         Decimal  @db.Decimal(14, 2)
  quelle         String?
  erstelltAm     DateTime @default(now())

  mandant      Mandant      @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([gesellschaftId])
}

enum PlanpositionArt {
  AUSSCHUETTUNG
  EINNAHME
  AUSGABE
}

/// Geplante Zahlung einer Gesellschaft in einem Monat (Ausschüttung, sonstige Einnahme oder Ausgabe).
model Planposition {
  id             String          @id @default(cuid())
  mandantId      String
  gesellschaftId String
  art            PlanpositionArt
  /// Erster Tag des Monats, in dem die Zahlung geplant ist
  monat          DateTime        @db.Date
  /// Betrag immer positiv; die Richtung ergibt sich aus der Art
  betrag         Decimal         @db.Decimal(14, 2)
  bezeichnung    String
  quelle         String?
  /// Bauteil des Instandhaltungsplans, aus dem die Position übernommen wurde
  bauteilId      String?
  erstelltAm     DateTime        @default(now())
  geaendertAm    DateTime        @updatedAt

  mandant      Mandant      @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)
  bauteil      Bauteil?     @relation(fields: [bauteilId], references: [id], onDelete: SetNull)

  @@index([mandantId])
  @@index([gesellschaftId])
  @@index([bauteilId])
}

/// Gespeicherte Exit-Kalkulation eines Hauses (Annahmen; gerechnet wird immer neu im Code).
model Exitrechnung {
  id              String   @id @default(cuid())
  mandantId       String
  hausId          String
  name            String
  verkaufsdatum   DateTime @db.Date
  /// "miete", "marktwert", "gutachten" oder "frei"
  preisBasis      String
  /// nur bei Basis "frei"
  preis           Decimal? @db.Decimal(14, 2)
  /// Kaufpreisfaktor für die Basis "miete"; null = aus dem Gutachten
  faktor          Decimal? @db.Decimal(9, 4)
  maklerProzent   Decimal  @db.Decimal(9, 4)
  sonstigeProzent Decimal  @db.Decimal(9, 4)
  /// Vorfälligkeitsentschädigung in Prozent der Ablöse; null = unbekannt
  vfeProzent      Decimal? @db.Decimal(9, 4)
  /// Begründung bzw. Quellen der Annahmen
  notiz           String?
  erstelltAm      DateTime @default(now())
  geaendertAm     DateTime @updatedAt

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus    Haus    @relation(fields: [hausId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([hausId])
}

/// Frage an den KI-Assistenten mit generativer Antwort (Text und Bausteine wie Diagramme,
/// Tabellen, Kacheln). Die KI wählt nur Datenabfragen und Bausteine; alle Zahlen stehen in
/// `daten` (vom Code berechnet, mit Quelle und Stichtag) und werden so angezeigt, wie sie beim
/// Fragen galten. Nur für den fragenden Benutzer sichtbar, weil `daten` seiner Sichtbarkeit folgt.
model KiFrage {
  id            String          @id @default(cuid())
  mandantId     String
  benutzerId    String
  frage         String
  stichtag      DateTime        @db.Date
  modell        String
  status        KiAnalyseStatus
  /// Gewählte Datenabfragen und ihre Ergebnisse (Werte als Text)
  daten         Json?
  /// Bausteine der Antwort nach der Prüfung
  antwort       Json?
  fehler        String?
  tokensEingabe Int?
  tokensAusgabe Int?
  erstelltAm    DateTime        @default(now())

  mandant  Mandant  @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  benutzer Benutzer @relation(fields: [benutzerId], references: [id], onDelete: Cascade)

  @@index([mandantId, benutzerId])
}

/// Woher ein Eintrag im Posteingang kommt.
enum EingangQuelle {
  HOCHLADEN
  UPLOAD_LINK
  EMAIL
}

enum EingangStatus {
  /// Vorschlag mit sicherer Zuordnung, wartet auf Bestätigung
  ZU_PRUEFEN
  /// Zuordnung unsicher oder unbekannt: nur mit vollständiger Prüfung übernehmen
  UNSICHER
  /// Mail von unbekanntem Absender: erst freigeben, dann prüfen
  QUARANTAENE
  UEBERNOMMEN
  ABGELEHNT
}

/// Posteingang je Mandant: jede eingehende Datei (Hochladen, Upload-Link, E-Mail) landet hier
/// zuerst, mit Vorschlag und Begründung. Erst nach Bestätigung wird daraus ein Dokument.
model Eingang {
  id               String              @id @default(cuid())
  mandantId        String
  quelle           EingangQuelle
  status           EingangStatus
  dateiname        String
  mimeType         String
  groesseBytes     Int
  speicherPfad     String
  pruefsumme       String
  /// Erkannter Text je Seite (Liste von Texten)
  seiten           Json?
  textQuelle       DokumentTextQuelle?
  textHinweis      String?
  seitenAnzahl     Int?
  /// E-Mail-Adresse des Absenders (bei Mails)
  absenderAdresse  String?
  /// z. B. Name des Upload-Links oder der hochladenden Person
  absenderHinweis  String?
  betreff          String?
  mailtext         String?
  /// Vorschlag mit Begründungen (siehe src/lib/eingang.ts)
  vorschlag        Json?
  hochgeladenVonId String?
  uploadLinkId     String?
  eingangMailId    String?
  dokumentId       String?             @unique
  bearbeitetVonId  String?
  bearbeitetAm     DateTime?
  erstelltAm       DateTime            @default(now())

  mandant     Mandant      @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  dokument    Dokument?    @relation(fields: [dokumentId], references: [id], onDelete: SetNull)
  uploadLink  UploadLink?  @relation(fields: [uploadLinkId], references: [id], onDelete: SetNull)
  eingangMail EingangMail? @relation(fields: [eingangMailId], references: [id], onDelete: SetNull)

  @@index([mandantId, status])
  @@index([mandantId, pruefsumme])
}

/// Persönlicher, widerrufbarer Link zum Hochladen in den Posteingang (z. B. für Hausverwaltung,
/// Bank oder Gutachter), ohne Zugriff auf den Rest der App. Gespeichert wird nur der Hash des Schlüssels.
model UploadLink {
  id             String       @id @default(cuid())
  mandantId      String
  /// Für wen der Link ist, z. B. „Hausverwaltung Müller“
  name           String
  absenderArt    AbsenderArt?
  schluesselHash String       @unique
  /// Die letzten Zeichen des Schlüssels zum Wiedererkennen
  schluesselEnde String
  gueltigBis     DateTime
  widerrufenAm   DateTime?
  zuletztGenutzt DateTime?
  anzahlDateien  Int          @default(0)
  erstelltVonId  String?
  erstelltAm     DateTime     @default(now())
  geaendertAm    DateTime     @updatedAt

  mandant   Mandant   @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  eingaenge Eingang[]

  @@index([mandantId])
}

/// Import-Adresse des Mandanten für den E-Mail-Eingang: <kennung>@<EINGANG_MAIL_DOMAIN>
model MailPostfach {
  id          String   @id @default(cuid())
  mandantId   String   @unique
  kennung     String   @unique
  aktiv       Boolean  @default(true)
  erstelltAm  DateTime @default(now())
  geaendertAm DateTime @updatedAt

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
}

/// Bekannte Absender für den E-Mail-Eingang: eine Adresse oder eine ganze Domain („@bank.de“).
/// Mails anderer Absender kommen in Quarantäne.
model MailAbsender {
  id            String       @id @default(cuid())
  mandantId     String
  /// klein geschrieben; „@domain.de“ für alle Adressen der Domain
  adresse       String
  name          String?
  absenderArt   AbsenderArt?
  erstelltVonId String?
  erstelltAm    DateTime     @default(now())
  geaendertAm   DateTime     @updatedAt

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  @@unique([mandantId, adresse])
}

enum MailErgebnis {
  /// Anhänge in die Prüfung aufgenommen
  AUFGENOMMEN
  /// Unbekannter oder verdächtiger Absender: Anhänge in Quarantäne
  QUARANTAENE
  /// Keine verwertbaren Anhänge
  OHNE_ANHANG
  /// Bereits empfangen (gleiche Message-ID)
  DOPPELT
  FEHLER
}

/// Protokoll jeder empfangenen Mail an die Import-Adresse, auch wenn nichts aufgenommen wurde.
model EingangMail {
  id             String       @id @default(cuid())
  mandantId      String
  von            String
  vonName        String?
  betreff        String?
  nachrichtId    String?
  /// Ergebnis der Absenderprüfung des Mail-Dienstes (SPF/DKIM/DMARC), falls mitgeliefert
  pruefung       String?
  ergebnis       MailErgebnis
  hinweis        String?
  anzahlAnhaenge Int          @default(0)
  aufgenommen    Int          @default(0)
  groesseBytes   Int          @default(0)
  empfangenAm    DateTime     @default(now())

  mandant   Mandant   @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  eingaenge Eingang[]

  @@index([mandantId, empfangenAm])
}

enum SicherheitArt {
  GRUNDSCHULD
  HYPOTHEK
  BUERGSCHAFT
  ABTRETUNG_MIETEN
  ABTRETUNG_SONSTIGE
  VERPFAENDUNG
  PATRONATSERKLAERUNG
  SONSTIGE
}

enum SicherheitQuelle {
  GRUNDBUCHAUSZUG
  SICHERUNGSVERTRAG
  BANKBESTAETIGUNG
  SONSTIGE
}

/// Kreditsicherheit: Grundschuld (je Haus, mit Rang), Bürgschaft, Abtretung usw.,
/// mit Quelle und Stand. Gesamtgrundschulden lasten auf mehreren Häusern.
model Sicherheit {
  id              String           @id @default(cuid())
  mandantId       String
  art             SicherheitArt
  /// Gläubiger, meist die Bank
  glaeubiger      String
  /// Nominalbetrag (Grundschuld, Bürgschaft); bei Abtretungen oft leer
  betrag          Decimal?         @db.Decimal(14, 2)
  /// Rang in Abteilung III (1 = erstrangig)
  rang            Int?
  /// z. B. „Grundbuch von Lindenhof, Blatt 1234, Abt. III lfd. Nr. 2“
  fundstelle      String?
  /// Sicherungsgeber, z. B. bürgende Gesellschaft oder Person
  sicherungsgeber String?
  gesellschaftId  String?
  eingetragenAm   DateTime?        @db.Date
  gueltigBis      DateTime?        @db.Date
  /// Gelöscht bzw. freigegeben am (bleibt zur Nachvollziehbarkeit erhalten)
  geloeschtAm     DateTime?        @db.Date
  quelle          SicherheitQuelle @default(SONSTIGE)
  /// Stand der Angabe laut Quelle
  stand           DateTime?        @db.Date
  dokumentId      String?
  notiz           String?
  erstelltAm      DateTime         @default(now())
  geaendertAm     DateTime         @updatedAt

  mandant      Mandant            @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft?      @relation(fields: [gesellschaftId], references: [id], onDelete: SetNull)
  dokument     Dokument?          @relation(fields: [dokumentId], references: [id], onDelete: SetNull)
  haeuser      SicherheitHaus[]
  kredite      SicherheitKredit[]

  @@index([mandantId])
}

model SicherheitHaus {
  id           String @id @default(cuid())
  mandantId    String
  sicherheitId String
  hausId       String

  mandant    Mandant    @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  sicherheit Sicherheit @relation(fields: [sicherheitId], references: [id], onDelete: Cascade)
  haus       Haus       @relation(fields: [hausId], references: [id], onDelete: Cascade)

  @@unique([sicherheitId, hausId])
}

/// Welche Kredite eine Sicherheit sichert (Zweckerklärung)
model SicherheitKredit {
  id           String @id @default(cuid())
  mandantId    String
  sicherheitId String
  kreditId     String

  mandant    Mandant    @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  sicherheit Sicherheit @relation(fields: [sicherheitId], references: [id], onDelete: Cascade)
  kredit     Kredit     @relation(fields: [kreditId], references: [id], onDelete: Cascade)

  @@unique([sicherheitId, kreditId])
}

enum AngebotStatus {
  /// Ausgelesen oder angelegt, noch nicht bestätigt
  ENTWURF
  /// Werte geprüft und bestätigt; nur diese kommen in den Vergleich
  BESTAETIGT
}

/// Finanzierungsangebot einer Bank (Term Sheet). Werte in Prozent sind Prozentpunkte p. a.
model Bankangebot {
  id                        String        @id @default(cuid())
  mandantId                 String
  bank                      String
  bezeichnung               String?
  gesellschaftId            String?
  /// Kredit, der abgelöst bzw. refinanziert werden soll
  kreditId                  String?
  /// Term Sheet in der Dateiablage
  dokumentId                String?
  angebotVom                DateTime?     @db.Date
  gueltigBis                DateTime?     @db.Date
  betrag                    Decimal?      @db.Decimal(14, 2)
  zinsArt                   ZinsArt       @default(FEST)
  sollzins                  Decimal?      @db.Decimal(9, 6)
  referenzzins              String?
  marge                     Decimal?      @db.Decimal(9, 6)
  zinsbindungMonate         Int?
  laufzeitMonate            Int?
  zahlweise                 Zahlweise     @default(MONATLICH)
  tilgungsart               Tilgungsart   @default(ANNUITAET)
  tilgungProzent            Decimal?      @db.Decimal(9, 6)
  /// 100 = volle Auszahlung, darunter Disagio
  auszahlungProzent         Decimal?      @db.Decimal(9, 6)
  bearbeitungsgebuehr       Decimal?      @db.Decimal(14, 2)
  sonstigeKosten            Decimal?      @db.Decimal(14, 2)
  /// Bereitstellungszins in Prozent je Monat (nicht in den Gesamtkosten, hängt vom Abruf ab)
  bereitstellungszins       Decimal?      @db.Decimal(9, 6)
  bereitstellungsfreiMonate Int?
  /// Sondertilgungsrecht in Prozent des Darlehensbetrags je Jahr
  sondertilgungProzent      Decimal?      @db.Decimal(9, 6)
  covenants                 String?
  sicherheiten              String?
  notiz                     String?
  status                    AngebotStatus @default(ENTWURF)
  /// Ausgelesene Werte mit Beleg und Herkunft (Regel, KI, berechnet), siehe src/lib/bankangebot.ts
  vorschlag                 Json?
  kiModell                  String?
  erstelltVonId             String?
  bestaetigtVonId           String?
  bestaetigtAm              DateTime?
  erstelltAm                DateTime      @default(now())
  geaendertAm               DateTime      @updatedAt

  mandant      Mandant       @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft? @relation(fields: [gesellschaftId], references: [id], onDelete: SetNull)
  kredit       Kredit?       @relation(fields: [kreditId], references: [id], onDelete: SetNull)
  dokument     Dokument?     @relation(fields: [dokumentId], references: [id], onDelete: SetNull)

  @@index([mandantId, status])
}

enum RegelMerkmal {
  /// IBAN im Text
  IBAN
  /// Darlehens-, Konto- oder Vertragsnummer im Text
  KENNUNG
  /// E-Mail-Adresse des Absenders
  ABSENDER_ADRESSE
  /// Name des Absenders im Briefkopf
  ABSENDER_NAME
}

/// Gelernte Zuordnung aus Korrekturen im Posteingang: Merkmal (z. B. IBAN) → Objekt und/oder Absender.
model Zuordnungsregel {
  id             String       @id @default(cuid())
  mandantId      String
  merkmal        RegelMerkmal
  /// Normalisierter Wert (ohne Leerzeichen, klein)
  wert           String
  gesellschaftId String?
  hausId         String?
  kreditId       String?
  absenderArt    AbsenderArt?
  absenderName   String?
  /// Wie oft die Regel bestätigt wurde
  anzahl         Int          @default(1)
  erstelltVonId  String?
  erstelltAm     DateTime     @default(now())
  geaendertAm    DateTime     @updatedAt

  mandant      Mandant       @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft? @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)
  haus         Haus?         @relation(fields: [hausId], references: [id], onDelete: Cascade)
  kredit       Kredit?       @relation(fields: [kreditId], references: [id], onDelete: Cascade)

  @@unique([mandantId, merkmal, wert])
}

/// Erstellter Covenant-Nachweis für die Bank: eingefrorener Stand aller Werte zum Stichtag (JSON),
/// damit das PDF später genau so wieder erzeugt werden kann.
model CovenantNachweis {
  id          String   @id @default(cuid())
  mandantId   String
  kreditId    String
  stichtag    DateTime @db.Date
  inhalt      Json
  erstelltVon String?
  erstelltAm  DateTime @default(now())

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  kredit  Kredit  @relation(fields: [kreditId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([kreditId, stichtag])
}

enum BerichtStatus {
  ENTWURF
  FREIGEGEBEN
  VERWORFEN
}

/// Quartalsbericht mit eingefrorenem Stand zum Quartalsende (JSON) und Vier-Augen-Freigabe.
/// gesellschaftId null = ganzes Portfolio des Mandanten.
model Quartalsbericht {
  id                 String        @id @default(cuid())
  mandantId          String
  gesellschaftId     String?
  jahr               Int
  quartal            Int
  stichtag           DateTime      @db.Date
  status             BerichtStatus @default(ENTWURF)
  inhalt             Json
  /// Kommentar der Geschäftsführung; nur im Entwurf änderbar
  kommentar          String?
  erstelltVonId      String
  erstelltVonName    String
  erstelltAm         DateTime      @default(now())
  freigegebenVonId   String?
  freigegebenVonName String?
  freigegebenAm      DateTime?
  verworfenGrund     String?
  geaendertAm        DateTime      @updatedAt

  mandant      Mandant       @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft? @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([gesellschaftId, jahr, quartal])
}

/// Kapitalabruf einer Gesellschaft: Gesamtbetrag, anteilig nach Beteiligung auf die Gesellschafter verteilt.
model Kapitalabruf {
  id             String   @id @default(cuid())
  mandantId      String
  gesellschaftId String
  bezeichnung    String
  abrufAm        DateTime @db.Date
  faelligAm      DateTime @db.Date
  gesamtbetrag   Decimal  @db.Decimal(14, 2)
  notiz          String?
  erstelltVon    String?
  erstelltAm     DateTime @default(now())

  mandant      Mandant                @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft           @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)
  positionen   KapitalabrufPosition[]

  @@index([mandantId, gesellschaftId])
}

/// Anteil eines Gesellschafters an einem Kapitalabruf; Eingänge sind Einlagen (Kapitalbewegung) mit Verweis hierauf.
model KapitalabrufPosition {
  id               String  @id @default(cuid())
  mandantId        String
  abrufId          String
  gesellschafterId String
  /// Beteiligung zum Zeitpunkt des Abrufs
  anteilProzent    Decimal @db.Decimal(9, 6)
  betrag           Decimal @db.Decimal(14, 2)

  mandant        Mandant           @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  abruf          Kapitalabruf      @relation(fields: [abrufId], references: [id], onDelete: Cascade)
  gesellschafter Gesellschafter    @relation(fields: [gesellschafterId], references: [id], onDelete: Cascade)
  eingaenge      Kapitalbewegung[]

  @@index([mandantId, abrufId])
}

enum PlanStatus {
  ENTWURF
  BESCHLOSSEN
}

/// Plan (Budget) einer Gesellschaft für ein Geschäftsjahr; Posten wie in der GuV. Das Ist kommt aus dem Geschäftsjahr gleichen Jahres.
model Planjahr {
  id             String     @id @default(cuid())
  mandantId      String
  gesellschaftId String
  jahr           Int
  status         PlanStatus @default(ENTWURF)
  /// z. B. „Budget 2025, Gesellschafterbeschluss vom 12.12.2024“
  quelle         String?
  beschlossenAm  DateTime?  @db.Date

  umsatzerloese        Decimal? @db.Decimal(14, 2)
  sonstigeErtraege     Decimal? @db.Decimal(14, 2)
  materialaufwand      Decimal? @db.Decimal(14, 2)
  personalaufwand      Decimal? @db.Decimal(14, 2)
  sonstigeAufwendungen Decimal? @db.Decimal(14, 2)
  abschreibungen       Decimal? @db.Decimal(14, 2)
  zinsertraege         Decimal? @db.Decimal(14, 2)
  zinsaufwendungen     Decimal? @db.Decimal(14, 2)
  steuern              Decimal? @db.Decimal(14, 2)
  jahresergebnis       Decimal? @db.Decimal(14, 2)

  notiz       String?
  erstelltVon String?
  angelegtAm  DateTime @default(now())
  geaendertAm DateTime @updatedAt

  mandant      Mandant          @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  gesellschaft Gesellschaft     @relation(fields: [gesellschaftId], references: [id], onDelete: Cascade)
  erklaerungen Planerklaerung[]

  @@unique([gesellschaftId, jahr])
  @@index([mandantId])
}

/// Erklärung einer Abweichung zwischen Plan und Ist für eine Zeile (GuV-Posten oder Kennzahl wie EBITDA).
model Planerklaerung {
  id          String   @id @default(cuid())
  mandantId   String
  planjahrId  String
  zeile       String
  text        String
  erstelltVon String?
  geaendertAm DateTime @updatedAt

  mandant  Mandant  @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  planjahr Planjahr @relation(fields: [planjahrId], references: [id], onDelete: Cascade)

  @@unique([planjahrId, zeile])
  @@index([mandantId])
}

enum EnergieausweisArt {
  BEDARF
  VERBRAUCH
}

/// Energieausweis eines Hauses; mehrere je Haus möglich (Verlauf), maßgeblich ist der zuletzt gültige.
model Energieausweis {
  id               String            @id @default(cuid())
  mandantId        String
  hausId           String
  art              EnergieausweisArt
  /// A+ bis H laut Ausweis; null = nicht angegeben
  energieklasse    String?
  /// Endenergie in kWh/(m²·a) laut Ausweis
  endenergie       Decimal?          @db.Decimal(9, 2)
  /// Primärenergie in kWh/(m²·a) laut Ausweis
  primaerenergie   Decimal?          @db.Decimal(9, 2)
  /// wesentlicher Energieträger, z. B. Erdgas, Fernwärme
  energietraeger   String?
  ausgestelltAm    DateTime?         @db.Date
  gueltigBis       DateTime?         @db.Date
  registriernummer String?
  quelle           String?
  notiz            String?
  erstelltVon      String?
  erstelltAm       DateTime          @default(now())

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus    Haus    @relation(fields: [hausId], references: [id], onDelete: Cascade)

  @@index([mandantId])
  @@index([hausId])
}

enum Energiemedium {
  WAERME
  STROM
  WASSER
}

/// Verbrauch eines Hauses je Kalenderjahr und Medium (Wärme und Strom in kWh, Wasser in m³) mit Quelle.
model Energieverbrauch {
  id             String        @id @default(cuid())
  mandantId      String
  hausId         String
  jahr           Int
  medium         Energiemedium
  menge          Decimal       @db.Decimal(14, 2)
  kosten         Decimal?      @db.Decimal(14, 2)
  /// CO₂-Emissionen in kg laut Quelle (z. B. Heizkostenabrechnung nach CO2KostAufG); null = nicht angegeben
  co2Kg          Decimal?      @db.Decimal(14, 2)
  energietraeger String?
  quelle         String
  notiz          String?
  erstelltAm     DateTime      @default(now())

  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus    Haus    @relation(fields: [hausId], references: [id], onDelete: Cascade)

  @@unique([hausId, jahr, medium])
  @@index([mandantId])
}

enum BauteilArt {
  DACH
  FASSADE
  FENSTER
  HEIZUNG
  AUFZUG
  LEITUNGEN
  ELEKTRO
  TREPPENHAUS
  AUSSENANLAGEN
  SONSTIGES
}

/// Bauteil eines Hauses im Instandhaltungsplan: nächste Erneuerung = letzte Erneuerung + Zyklus.
/// Fehlen Jahr oder Zyklus, ist die Fälligkeit unbekannt (keine Annahme).
model Bauteil {
  id                String     @id @default(cuid())
  mandantId         String
  hausId            String
  art               BauteilArt
  bezeichnung       String
  /// Erneuerungszyklus in Jahren; null = unbekannt
  zyklusJahre       Int?
  /// Jahr der letzten Erneuerung (oder Baujahr); null = unbekannt
  letzteErneuerung  Int?
  /// geplante Kosten der nächsten Erneuerung; null = unbekannt
  geplanteKosten    Decimal?   @db.Decimal(14, 2)
  /// Herkunft der Kosten, z. B. "Angebot Dachdecker Müller"
  kostenQuelle      String?
  /// Stand der Kostenangabe
  kostenStand       DateTime?  @db.Date
  notiz             String?
  erstelltVon       String?
  erstelltAm        DateTime   @default(now())
  geaendertAm       DateTime   @updatedAt

  mandant         Mandant        @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus            Haus           @relation(fields: [hausId], references: [id], onDelete: Cascade)
  planpositionen  Planposition[]

  @@index([mandantId])
  @@index([hausId])
}

enum BriefvorlageArt {
  MIETERHOEHUNG
  ALLGEMEIN
}

/// Vorlage für Serienbriefe an Mieter; Platzhalter in der Form {{name}}.
model Briefvorlage {
  id          String          @id @default(cuid())
  mandantId   String
  name        String
  art         BriefvorlageArt
  betreff     String
  text        String
  erstelltVon String?
  erstelltAm  DateTime        @default(now())
  geaendertAm DateTime        @updatedAt

  mandant  Mandant      @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  serien   Briefserie[]

  @@index([mandantId])
}

/// Erstellter Serienbrief: Vorlagenstand und Parameter werden festgehalten, die Briefe liegen als
/// Dokumente beim jeweiligen Mietverhältnis.
model Briefserie {
  id             String          @id @default(cuid())
  mandantId      String
  briefvorlageId String?
  art            BriefvorlageArt
  titel          String
  /// Briefdatum
  datum          DateTime        @db.Date
  betreff        String
  text           String
  /// Erhöhung in Prozent (nur Mieterhöhung)
  prozent        Decimal?        @db.Decimal(6, 2)
  /// Erhöhung in € je Monat (nur Mieterhöhung, statt Prozent)
  betrag         Decimal?        @db.Decimal(12, 2)
  erstelltVon    String?
  erstelltAm     DateTime        @default(now())

  mandant      Mandant       @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  briefvorlage Briefvorlage? @relation(fields: [briefvorlageId], references: [id], onDelete: SetNull)
  dokumente    Dokument[]

  @@index([mandantId])
}

enum MieterstandArt {
  /// vollständige Mieterliste
  VOLLSTAENDIG
  /// nur Leerstandsdaten (z. B. alte Leerstandsliste); nicht genannte Einheiten sind unbekannt
  NUR_LEERSTAND
}

/// Gespeicherter Stand einer Mieterliste je Haus. Wird nie überschrieben; bei mehreren
/// Ständen zum selben Stichtag gilt der zuletzt angelegte.
model Mieterstand {
  id              String         @id @default(cuid())
  mandantId       String
  hausId          String
  stichtag        DateTime       @db.Date
  art             MieterstandArt @default(VOLLSTAENDIG)
  /// Herkunft, z. B. Dateiname der importierten Liste
  quelle          String
  importvorgangId String?
  erstelltVon     String?
  erstelltAm      DateTime       @default(now())

  mandant       Mandant            @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus          Haus               @relation(fields: [hausId], references: [id], onDelete: Cascade)
  importvorgang Importvorgang?     @relation(fields: [importvorgangId], references: [id], onDelete: SetNull)
  zeilen        MieterstandZeile[]

  @@index([mandantId, hausId, stichtag])
}

/// Eine Einheit in einem Mieterstand. Fehlende Werte bleiben null (= unbekannt).
model MieterstandZeile {
  id             String     @id @default(cuid())
  mandantId      String
  standId        String
  einheitId      String?
  /// Bezeichnung wie in der Liste (bleibt erhalten, auch wenn die Einheit gelöscht wird)
  einheit        String
  art            EinheitArt
  flaeche        Decimal?   @db.Decimal(10, 2)
  /// true = leer, false = vermietet, null = unbekannt
  leer           Boolean?
  mieter         String?
  beginn         DateTime?  @db.Date
  ende           DateTime?  @db.Date
  sollMiete      Decimal?   @db.Decimal(14, 2)
  istMiete       Decimal?   @db.Decimal(14, 2)
  /// Nebenkostenvorauszahlung je Monat
  nebenkosten    Decimal?   @db.Decimal(14, 2)
  /// erwartete Miete bei Leerstand (Soll-Miete der leeren Einheit)
  erwarteteMiete Decimal?   @db.Decimal(14, 2)

  mandant  Mandant     @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  stand    Mieterstand @relation(fields: [standId], references: [id], onDelete: Cascade)
  einheitR Einheit?    @relation(fields: [einheitId], references: [id], onDelete: SetNull)

  @@index([standId])
  @@index([mandantId, einheitId])
}

/// Hausverwaltung als Unternehmen (nicht der Benutzerzugang). Wird je Haus mit Zeitraum zugeordnet.
model Hausverwaltung {
  id              String   @id @default(cuid())
  mandantId       String
  name            String
  ansprechpartner String?
  email           String?
  telefon         String?
  notiz           String?
  erstelltAm      DateTime @default(now())
  geaendertAm     DateTime @updatedAt

  mandant     Mandant                   @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  zuordnungen HausverwaltungZuordnung[]

  @@index([mandantId])
}

/// Zuordnung Haus → Hausverwaltung für einen Zeitraum; bis = null heißt „läuft“.
model HausverwaltungZuordnung {
  id               String    @id @default(cuid())
  mandantId        String
  hausId           String
  hausverwaltungId String
  von              DateTime  @db.Date
  bis              DateTime? @db.Date
  notiz            String?
  erstelltAm       DateTime  @default(now())

  mandant        Mandant        @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  haus           Haus           @relation(fields: [hausId], references: [id], onDelete: Cascade)
  hausverwaltung Hausverwaltung @relation(fields: [hausverwaltungId], references: [id], onDelete: Cascade)

  @@index([mandantId, hausId])
  @@index([hausverwaltungId])
}
